#version 450
// Writes each invocation's linear global index. Verifies dispatch geometry:
// every element must equal its own index after the dispatch completes.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Out { uint data[]; };
layout(push_constant) uniform PC { uint count; } pc;
void main() {
    uvec3 n = gl_NumWorkGroups * gl_WorkGroupSize;
    uint idx = gl_GlobalInvocationID.x
             + gl_GlobalInvocationID.y * n.x
             + gl_GlobalInvocationID.z * n.x * n.y;
    if (idx < pc.count) data[idx] = idx;
}
