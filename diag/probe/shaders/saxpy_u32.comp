#version 450
// y[i] = a * x[i] + y[i] with uint32 wrap-around: exact, no float rounding.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer X { uint x[]; };
layout(std430, binding = 1) buffer Y { uint y[]; };
layout(push_constant) uniform PC { uint count; uint a; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 64u;
    if (i < pc.count) y[i] = pc.a * x[i] + y[i];
}
