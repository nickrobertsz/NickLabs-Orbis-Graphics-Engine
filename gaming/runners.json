      ],
      "sha512_url": "https://github.com/GloriousEggroll/proton-ge-custom/releases/download/GE-Proton10-34/GE-Proton10-34.sha512sum",
      "file": "GE-Proton10-34.tar.gz",
      "install": "$STEAM_COMPAT/GE-Proton10-34",
      "note": "DXVK 2.x line (Vulkan 1.3 + dynamic rendering). Expected automatic pick for RADV on Liverpool (GFX7) unless orbis-games caps proves 3.x support."
    },
