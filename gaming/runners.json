      "urls": [
        "https://github.com/GloriousEggroll/proton-ge-custom/releases/download/GE-Proton7-55/GE-Proton7-55.tar.gz"
      ],
      "sha512_url": "https://github.com/GloriousEggroll/proton-ge-custom/releases/download/GE-Proton7-55/GE-Proton7-55.sha512sum",
      "file": "GE-Proton7-55.tar.gz",
