{
  "schema": "orbis-runners/1",
  "about": "Pinned Windows-game runners for NickLabs Orbis. Downloaded on the Nobara (orbis-games fetch), installed on the console from the offline bundle (orbis-games install). URLs checked against the GitHub release asset lists on 2026-10-26. To add a LAN mirror, put extra URLs after the GitHub one in 'urls' (tried in order); integrity is enforced by the upstream .sha512sum (GE-Proton) and by runners.lock.json (SHA-256, recorded at first download).",
  "runners": [
    {
      "id": "GE-Proton11-11",
      "kind": "proton",
      "version": "11-11",
      "dxvk_line": "3.x",
      "urls": [
        "https://github.com/GloriousEggroll/proton-ge-custom/releases/download/GE-Proton11-11/GE-Proton11-11-x86_64.tar.gz"
      ],
      "sha512_url": "https://github.com/GloriousEggroll/proton-ge-custom/releases/download/GE-Proton11-11/GE-Proton11-11-x86_64.sha512sum",
      "file": "GE-Proton11-11-x86_64.tar.gz",
      "install": "$STEAM_COMPAT/GE-Proton11-11",
      "note": "Newest pin. Needs the DXVK 3.x Vulkan feature set; on drivers that lack it orbis-run picks an older line. Asset is the -x86_64 tarball (an aarch64 build also exists)."
    },
    {
      "id": "GE-Proton10-34",
      "kind": "proton",
      "version": "10-34",
      "dxvk_line": "2.x",
      "urls": [
