# NickLabs Orbis Graphics Engine 2.0 - merged AFTER the Orbis 0.2.0 fragments
# (kernel/build-ge-kernel.sh). Release name 6.15.4-orbis-ps4-ge-<commit>.
CONFIG_LOCALVERSION="-orbis-ps4-ge"

# PS4 Jaguar cpufreq driver (patch ge-6.15/0007) + governors for PC/GAMING/AI policies
CONFIG_PS4_CPUFREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y

# Unified-memory policy: pressure stall information drives orbis-memd
CONFIG_PSI=y

# NickLabs Orbis Black Box: lockup/hang detectors, SysRq, LAN kernel log streaming,
# crash-capture kernel support (kdump, opt-in at runtime)
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x1fe
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_WQ_WATCHDOG=y
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_NETCONSOLE_EXTENDED_LOG=y
CONFIG_CRASH_DUMP=y
CONFIG_PROC_VMCORE=y
CONFIG_KEXEC_FILE=y
CONFIG_DEV_COREDUMP=y
CONFIG_PRINTK_TIME=y
