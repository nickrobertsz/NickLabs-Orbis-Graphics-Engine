From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "NickLabs Orbis (port)" <orbis@nicklabs.invalid>
Date: Mon, 26 Oct 2026 12:56:17 -0700
Subject: [PATCH] drm/amdgpu: restore and control the PS4 Liverpool/Gladius
 SCLK divider

Port of rmux's liverpool_clk (MIT) from sony-jaguar-devs/ps4-linux
6.18.21-Strawberry-GpuWork @ 79d8f7a to Linux 6.15.4. ps4-kexec's GFX soft reset
leaves SCLK at the fused startup divider; the community driver forces CG_SCLK_CNTL
direct control to DID 1 (full SPLL output, the clock GameOS ran at). It is applied at
cik_common hw_init (so also on resume and after a full ASIC reset) and from
post_soft_reset.

Orbis changes:
- only two hardware-defined states can be selected: DID 1 ("max") and the fused
  startup DID ("startup"); SPLL and voltages are never touched (no overclock);
- amdgpu.ps4_sclk_restore=1 (default) / 0 to leave the divider as kexec left it;
- sysfs <gpu>/ps4_sclk: key=value state; write "max" or "startup" at runtime;
- debugfs amdgpu_liverpool_clk with the raw GCK/SPLL registers;
- every transition is logged with before/after register values.

Status: applies to feeRnt 6.15.4 crashnt-4.7 + Orbis 0001; not compiled or boot-tested
by NickLabs Orbis. The EMC thermal protection is independent of these registers.
---
 drivers/gpu/drm/amd/amdgpu/Makefile         |   3 +-
 drivers/gpu/drm/amd/amdgpu/amdgpu_debugfs.c |  26 ++
 drivers/gpu/drm/amd/amdgpu/cik.c            |  21 ++
 drivers/gpu/drm/amd/amdgpu/liverpool_clk.c  | 356 ++++++++++++++++++++
 drivers/gpu/drm/amd/amdgpu/liverpool_clk.h  |  32 ++
 5 files changed, 437 insertions(+), 1 deletion(-)
 create mode 100644 drivers/gpu/drm/amd/amdgpu/liverpool_clk.c
 create mode 100644 drivers/gpu/drm/amd/amdgpu/liverpool_clk.h

diff --git a/drivers/gpu/drm/amd/amdgpu/Makefile b/drivers/gpu/drm/amd/amdgpu/Makefile
index fbf09618b..6f9f03842 100644
--- a/drivers/gpu/drm/amd/amdgpu/Makefile
+++ b/drivers/gpu/drm/amd/amdgpu/Makefile
@@ -74,7 +74,8 @@ amdgpu-$(CONFIG_PERF_EVENTS) += amdgpu_pmu.o
 
 # add asic specific block
 amdgpu-$(CONFIG_DRM_AMDGPU_CIK)+= cik.o cik_ih.o \
-	dce_v8_0.o gfx_v7_0.o cik_sdma.o uvd_v4_2.o vce_v2_0.o
+	dce_v8_0.o gfx_v7_0.o cik_sdma.o uvd_v4_2.o vce_v2_0.o \
+	liverpool_clk.o
 
 amdgpu-$(CONFIG_DRM_AMDGPU_SI)+= si.o gmc_v6_0.o gfx_v6_0.o si_ih.o si_dma.o dce_v6_0.o \
 	uvd_v3_1.o
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_debugfs.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_debugfs.c
index a1450f13d..f87bd74cc 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_debugfs.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_debugfs.c
@@ -36,6 +36,7 @@
 #include "amdgpu_securedisplay.h"
 #include "amdgpu_fw_attestation.h"
 #include "amdgpu_umr.h"
+#include "liverpool_clk.h"
 
 #include "amdgpu_reset.h"
 #include "amdgpu_psp_ta.h"
@@ -1811,6 +1812,28 @@ DEFINE_DEBUGFS_ATTRIBUTE(amdgpu_evict_gtt_fops, amdgpu_debugfs_evict_gtt,
 DEFINE_DEBUGFS_ATTRIBUTE(amdgpu_benchmark_fops, NULL, amdgpu_debugfs_benchmark,
 			 "%lld\n");
 
+static int amdgpu_debugfs_liverpool_clk_show(struct seq_file *m, void *unused)
+{
+	struct amdgpu_device *adev = m->private;
+	struct drm_device *dev = adev_to_drm(adev);
+	int r;
+
+	r = pm_runtime_get_sync(dev->dev);
+	if (r < 0) {
+		pm_runtime_put_autosuspend(dev->dev);
+		return r;
+	}
+
+	r = liverpool_clk_debugfs_print(adev, m);
+
+	pm_runtime_mark_last_busy(dev->dev);
+	pm_runtime_put_autosuspend(dev->dev);
+
+	return r;
+}
+
+DEFINE_SHOW_ATTRIBUTE(amdgpu_debugfs_liverpool_clk);
+
 static void amdgpu_ib_preempt_fences_swap(struct amdgpu_ring *ring,
 					  struct dma_fence **fences)
 {
@@ -2116,6 +2139,9 @@ int amdgpu_debugfs_init(struct amdgpu_device *adev)
 			    &amdgpu_debugfs_vm_info_fops);
 	debugfs_create_file("amdgpu_benchmark", 0200, root, adev,
 			    &amdgpu_benchmark_fops);
+	if (adev->asic_type == CHIP_LIVERPOOL || adev->asic_type == CHIP_GLADIUS)
+		debugfs_create_file("amdgpu_liverpool_clk", 0444, root, adev,
+				    &amdgpu_debugfs_liverpool_clk_fops);
 
 	adev->debugfs_vbios_blob.data = adev->bios;
 	adev->debugfs_vbios_blob.size = adev->bios_size;
diff --git a/drivers/gpu/drm/amd/amdgpu/cik.c b/drivers/gpu/drm/amd/amdgpu/cik.c
index 4867dbd47..3277093eb 100644
--- a/drivers/gpu/drm/amd/amdgpu/cik.c
+++ b/drivers/gpu/drm/amd/amdgpu/cik.c
@@ -43,6 +43,7 @@
 #include "dce_v8_0.h"
 #include "gfx_v7_0.h"
 #include "cik_sdma.h"
+#include "liverpool_clk.h"
 #include "uvd_v4_2.h"
 #include "vce_v2_0.h"
 #include "cik_dpm.h"
@@ -2534,11 +2535,18 @@ static int cik_common_hw_init(struct amdgpu_ip_block *ip_block)
 	/* enable aspm */
 	cik_program_aspm(adev);
 
+	if (adev->asic_type == CHIP_LIVERPOOL ||
+	    adev->asic_type == CHIP_GLADIUS) {
+		liverpool_clk_force_max(adev);
+		liverpool_clk_sysfs_init(adev);
+	}
+
 	return 0;
 }
 
 static int cik_common_hw_fini(struct amdgpu_ip_block *ip_block)
 {
+	liverpool_clk_sysfs_fini(ip_block->adev);
 	return 0;
 }
 
@@ -2560,6 +2568,18 @@ static int cik_common_soft_reset(struct amdgpu_ip_block *ip_block)
 	return 0;
 }
 
+static int cik_common_post_soft_reset(struct amdgpu_ip_block *ip_block)
+{
+	struct amdgpu_device *adev = ip_block->adev;
+
+	/* a GFX soft reset drops the PS4 SCLK divider back to the fused startup value */
+	if (adev->asic_type == CHIP_LIVERPOOL ||
+	    adev->asic_type == CHIP_GLADIUS)
+		return liverpool_clk_force_max(adev);
+
+	return 0;
+}
+
 static int cik_common_set_clockgating_state(struct amdgpu_ip_block *ip_block,
 					    enum amd_clockgating_state state)
 {
@@ -2580,6 +2600,7 @@ static const struct amd_ip_funcs cik_common_ip_funcs = {
 	.resume = cik_common_resume,
 	.is_idle = cik_common_is_idle,
 	.soft_reset = cik_common_soft_reset,
+	.post_soft_reset = cik_common_post_soft_reset,
 	.set_clockgating_state = cik_common_set_clockgating_state,
 	.set_powergating_state = cik_common_set_powergating_state,
 };
diff --git a/drivers/gpu/drm/amd/amdgpu/liverpool_clk.c b/drivers/gpu/drm/amd/amdgpu/liverpool_clk.c
new file mode 100644
index 000000000..44b216534
--- /dev/null
+++ b/drivers/gpu/drm/amd/amdgpu/liverpool_clk.c
@@ -0,0 +1,356 @@
+// SPDX-License-Identifier: MIT
+/**
+ * liverpool_clk.c - PS4 Liverpool/Gladius GPU clock force driver
+ *
+ * Copyright (C) rmux <armandas.kvietkus@proton.me>
+ *
+ * Based on ci_dpm.c (AMD GCN DPM framework).
+ * Thanks to fail0verflow for ps4-kexec and the Liverpool register map.
+ * Thanks to the ps4-linux community for hardware research and testing.
+ *
+ * ============================================================
+ * Root Cause
+ * ============================================================
+ * ps4-kexec performs a GFX soft-reset (RCU_GFX_STRAP |= 0x10003)
+ * before handing off to Linux. On GCN hardware a GFX soft-reset
+ * causes the SCLK divider (DID) to revert to the fuse-burnt startup
+ * value in GCK_SCLK_FUSES.StartupSClkDid, which corresponds to the
+ * strap/boot frequency (~200-300 MHz on Liverpool).
+ *
+ * pp_smu_ip_block is present in the IP block list for CHIP_LIVERPOOL
+ * and CHIP_GLADIUS but produces no functional DPM table and has never
+ * raised the clock across any ps4-linux rebase. The GPU runs at strap
+ * speed permanently.
+ *
+ * ============================================================
+ * Fix
+ * ============================================================
+ * Use the CG_SCLK_CNTL direct-control path (SCLKDIRCNTLEN +
+ * SCLKDIRCNTLTOG) to force SCLKDIRCNTLDIVIDER = 1 (DID 1, divide-
+ * by-1, full SPLL output) from cik_common_hw_init(), before any GFX
+ * ring or shader work begins.
+ *
+ * SCLKDIRCNTLEN is kept set permanently. This prevents any dormant
+ * DPM path from lowering the clock autonomously.
+ *
+ * ============================================================
+ * SPLL State After Soft-Reset
+ * ============================================================
+ * A GFX soft-reset does not reconfigure the GCK PLL block (separate
+ * power domain managed by SMC firmware). The SPLL remains locked to
+ * the operating frequency (~800 MHz Liverpool, ~911 MHz Gladius) set
+ * by the BIOS/hypervisor before kexec. Only the post-divider (DID)
+ * is reset. Forcing DID=1 restores the full SPLL output.
+ *
+ * If SPLL PDIVA > 4 at init time the SPLL may have been reconfigured
+ * by the soft-reset. The function logs PDIVA and FBDIV in that case
+ * for follow-up SPLL reprogramming support.
+ *
+ * ============================================================
+ * Voltage
+ * ============================================================
+ * The BIOS/hypervisor that configured the SPLL also set VID rails to
+ * operational levels before kexec. A GFX soft-reset does not touch
+ * the power plane.
+ *
+ * The EMC (Aeolia/Belize/Baikal, ARM Cortex-M3) provides an
+ * independent hardware thermal kill at 72 C (GPU domain, ICC command
+ * 0x0B/0x05 domain 2) and 97 C (APU shutdown) regardless of what
+ * Linux writes into the clock registers.
+ *
+ * ============================================================
+ * Register Reference
+ * ============================================================
+ * All registers accessed via RREG32_SMC / WREG32_SMC (SMC indirect
+ * at mmSMC_IND_INDEX_0 / mmSMC_IND_DATA_0, initialised in
+ * cik_common_early_init before this function is called).
+ * Source: bonaire.rai, GCK block. Field map: the register defines below.
+ *
+ * ============================================================
+ * NickLabs Orbis Graphics Engine 2.0 changes
+ * ============================================================
+ * Ported from sony-jaguar-devs/ps4-linux 6.18.21-Strawberry-GpuWork @ 79d8f7a
+ * ("amdgpu: harden Liverpool clock force and add debugfs") to Linux 6.15.4
+ * (feeRnt crashnt-4.7). Changes:
+ *   - liverpool_clk_set_did() generalises the force to the two hardware-defined
+ *     states only: DID 1 (full SPLL output, "max") and the fused startup DID
+ *     ("startup"). No other divider, no SPLL or voltage change: no overclock.
+ *   - amdgpu.ps4_sclk_restore=1 (default) applies "max" at hw_init and after a
+ *     soft reset, as the community driver does; 0 leaves the post-kexec divider.
+ *   - sysfs <pci device>/ps4_sclk: read = key=value state, write "max" / "startup".
+ *   - every change is logged with before/after register values.
+ */
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/seq_file.h>
+#include <linux/sysfs.h>
+#include "amdgpu.h"
+#include "liverpool_clk.h"
+
+#define GCK_SCLK_FUSES                  0xc0500004
+#define   STARTUP_SCLK_DID_SHIFT          0
+#define   STARTUP_SCLK_DID_MASK           (0x7f << 0)
+
+#define GCK_SPLL_FUSES                  0xc050002c
+#define   SPLL_FREQ_ID_STARTUP_SHIFT      1
+#define   SPLL_FREQ_ID_STARTUP_MASK       (0x3f << 1)
+#define   SPLL_FREQ_ID_MAX_SHIFT          7
+#define   SPLL_FREQ_ID_MAX_MASK           (0x3f << 7)
+
+#define CG_SCLK_CNTL                    0xc050008c
+#define   SCLK_DIVIDER_SHIFT              0
+#define   SCLK_DIVIDER_MASK               (0x7f << 0)
+#define   SCLK_DIRCNTL_EN                 BIT(8)
+#define   SCLK_DIRCNTL_TOG                BIT(9)
+#define   SCLK_DIRCNTL_DIV_SHIFT          10
+#define   SCLK_DIRCNTL_DIV_MASK           (0x7f << 10)
+
+#define CG_SCLK_STATUS                  0xc0500090
+#define   SCLK_STATUS_DONE                BIT(0)
+#define   SCLK_FORCE_STATUS_DONE          BIT(1)
+#define   SCLK_DIRCNTL_DONE_TOG           BIT(3)
+
+#define CG_SPLL_FUNC_CNTL               0xc0500100
+#define   SPLL_PDIVA_SHIFT                20
+#define   SPLL_PDIVA_MASK                 (0x7f << 20)
+
+#define CG_SPLL_FUNC_CNTL_3             0xc0500108
+#define   SPLL_FB_DIV_SHIFT               0
+#define   SPLL_FB_DIV_MASK                (0x3ffffff << 0)
+
+#define CG_SPLL_STATUS                  0xc0500114
+#define   SPLL_UNLOCK_STICKY              BIT(7)
+
+#define SCLK_STARTUP_DID                0xe000304c
+#define   SCLKSTARTUPDID_MASK             0x7f
+
+#define LIVERPOOL_MAX_SCLK_DID          1
+#define LIVERPOOL_CLK_TIMEOUT_US        10
+#define LIVERPOOL_CLK_TIMEOUT_ITER      1000
+
+static int ps4_sclk_restore = 1;
+module_param(ps4_sclk_restore, int, 0444);
+MODULE_PARM_DESC(ps4_sclk_restore,
+	"PS4 Liverpool/Gladius: restore the full SPLL SCLK (DID 1) at init and after reset "
+	"(1 = yes, default; 0 = keep the divider left by kexec)");
+
+static DEFINE_MUTEX(liverpool_clk_lock);
+static bool liverpool_clk_sysfs_added;
+
+static bool liverpool_clk_is_ps4(struct amdgpu_device *adev)
+{
+	return adev->asic_type == CHIP_LIVERPOOL || adev->asic_type == CHIP_GLADIUS;
+}
+
+struct liverpool_clk_state {
+	u32 spll_fuses, sclk_fuses, spll_cntl, spll_fb, cntl, status, spll_status;
+	u32 startup_did, smc_startup_did, pdiva, fbdiv;
+};
+
+static void liverpool_clk_read_state(struct amdgpu_device *adev, struct liverpool_clk_state *s)
+{
+	s->spll_fuses = RREG32_SMC(GCK_SPLL_FUSES);
+	s->sclk_fuses = RREG32_SMC(GCK_SCLK_FUSES);
+	s->spll_cntl = RREG32_SMC(CG_SPLL_FUNC_CNTL);
+	s->spll_fb = RREG32_SMC(CG_SPLL_FUNC_CNTL_3);
+	s->cntl = RREG32_SMC(CG_SCLK_CNTL);
+	s->status = RREG32_SMC(CG_SCLK_STATUS);
+	s->spll_status = RREG32_SMC(CG_SPLL_STATUS);
+	s->startup_did = (s->sclk_fuses & STARTUP_SCLK_DID_MASK) >> STARTUP_SCLK_DID_SHIFT;
+	s->smc_startup_did = RREG32_SMC(SCLK_STARTUP_DID) & SCLKSTARTUPDID_MASK;
+	s->pdiva = (s->spll_cntl & SPLL_PDIVA_MASK) >> SPLL_PDIVA_SHIFT;
+	s->fbdiv = (s->spll_fb & SPLL_FB_DIV_MASK) >> SPLL_FB_DIV_SHIFT;
+}
+
+static u32 liverpool_clk_active_did(const struct liverpool_clk_state *s)
+{
+	if (s->cntl & SCLK_DIRCNTL_EN)
+		return (s->cntl & SCLK_DIRCNTL_DIV_MASK) >> SCLK_DIRCNTL_DIV_SHIFT;
+	return (s->cntl & SCLK_DIVIDER_MASK) >> SCLK_DIVIDER_SHIFT;
+}
+
+/* caller holds liverpool_clk_lock */
+static int liverpool_clk_set_did_locked(struct amdgpu_device *adev, u32 did, const char *why)
+{
+	struct liverpool_clk_state s;
+	u32 cntl, status, target_tog;
+	int i;
+
+	liverpool_clk_read_state(adev, &s);
+	if (did != LIVERPOOL_MAX_SCLK_DID && did != s.startup_did)
+		return -EINVAL;	/* only the two hardware-defined states */
+
+	if (s.pdiva > 4)
+		dev_warn(adev->dev, "Liverpool CLK: SPLL PDIVA=%u > 4 (FBDIV=0x%x): SPLL may have been "
+			 "reconfigured by soft-reset\n", s.pdiva, s.fbdiv);
+	if (s.spll_status & SPLL_UNLOCK_STICKY)
+		dev_warn(adev->dev, "Liverpool CLK: SPLL unlock sticky set (0x%08x)\n", s.spll_status);
+
+	if ((s.cntl & SCLK_DIRCNTL_EN) && liverpool_clk_active_did(&s) == did)
+		return 0;
+
+	for (i = 0; i < LIVERPOOL_CLK_TIMEOUT_ITER; i++) {
+		if (RREG32_SMC(CG_SCLK_STATUS) & SCLK_STATUS_DONE)
+			break;
+		udelay(LIVERPOOL_CLK_TIMEOUT_US);
+	}
+	if (i == LIVERPOOL_CLK_TIMEOUT_ITER) {
+		dev_err(adev->dev, "Liverpool CLK: timed out waiting for SCLK idle (0x%08x)\n",
+			RREG32_SMC(CG_SCLK_STATUS));
+		return -ETIMEDOUT;
+	}
+
+	cntl = s.cntl;
+	cntl &= ~SCLK_DIRCNTL_DIV_MASK;
+	cntl |= (did << SCLK_DIRCNTL_DIV_SHIFT) & SCLK_DIRCNTL_DIV_MASK;
+	cntl |= SCLK_DIRCNTL_EN;
+	cntl ^= SCLK_DIRCNTL_TOG;
+	target_tog = cntl & SCLK_DIRCNTL_TOG;
+	WREG32_SMC(CG_SCLK_CNTL, cntl);
+
+	for (i = 0; i < LIVERPOOL_CLK_TIMEOUT_ITER; i++) {
+		status = RREG32_SMC(CG_SCLK_STATUS);
+		if ((status & SCLK_FORCE_STATUS_DONE) &&
+		    (!!(status & SCLK_DIRCNTL_DONE_TOG) == !!target_tog))
+			break;
+		udelay(LIVERPOOL_CLK_TIMEOUT_US);
+	}
+	if (i == LIVERPOOL_CLK_TIMEOUT_ITER) {
+		dev_err(adev->dev, "Liverpool CLK: timed out waiting for force done (0x%08x)\n",
+			RREG32_SMC(CG_SCLK_STATUS));
+		return -ETIMEDOUT;
+	}
+
+	cntl = RREG32_SMC(CG_SCLK_CNTL);
+	status = RREG32_SMC(CG_SCLK_STATUS);
+	dev_info(adev->dev, "Liverpool CLK: %s: DID %u -> %u (CG_SCLK_CNTL 0x%08x -> 0x%08x, status 0x%08x)\n",
+		 why, liverpool_clk_active_did(&s),
+		 (cntl & SCLK_DIRCNTL_DIV_MASK) >> SCLK_DIRCNTL_DIV_SHIFT, s.cntl, cntl, status);
+	if (((cntl & SCLK_DIRCNTL_DIV_MASK) >> SCLK_DIRCNTL_DIV_SHIFT) != did) {
+		dev_err(adev->dev, "Liverpool CLK: readback DID mismatch, expected %u\n", did);
+		return -EIO;
+	}
+	return 0;
+}
+
+int liverpool_clk_set_did(struct amdgpu_device *adev, u32 did, const char *why)
+{
+	int r;
+
+	if (!liverpool_clk_is_ps4(adev))
+		return -EINVAL;
+	mutex_lock(&liverpool_clk_lock);
+	r = liverpool_clk_set_did_locked(adev, did, why);
+	mutex_unlock(&liverpool_clk_lock);
+	return r;
+}
+
+int liverpool_clk_force_max(struct amdgpu_device *adev)
+{
+	struct liverpool_clk_state s;
+
+	if (!liverpool_clk_is_ps4(adev))
+		return 0;
+	liverpool_clk_read_state(adev, &s);
+	dev_info(adev->dev, "Liverpool CLK: SPLL startup_freq_id=%u max_freq_id=%u fused startup DID=%u "
+		 "SMC startup DID=%u PDIVA=%u FBDIV=0x%x CG_SCLK_CNTL=0x%08x\n",
+		 (s.spll_fuses & SPLL_FREQ_ID_STARTUP_MASK) >> SPLL_FREQ_ID_STARTUP_SHIFT,
+		 (s.spll_fuses & SPLL_FREQ_ID_MAX_MASK) >> SPLL_FREQ_ID_MAX_SHIFT,
+		 s.startup_did, s.smc_startup_did, s.pdiva, s.fbdiv, s.cntl);
+	if (!ps4_sclk_restore) {
+		dev_info(adev->dev, "Liverpool CLK: amdgpu.ps4_sclk_restore=0, divider left as found\n");
+		return 0;
+	}
+	return liverpool_clk_set_did(adev, LIVERPOOL_MAX_SCLK_DID, "restore full SPLL output");
+}
+
+int liverpool_clk_debugfs_print(struct amdgpu_device *adev, struct seq_file *m)
+{
+	struct liverpool_clk_state s;
+
+	if (!liverpool_clk_is_ps4(adev))
+		return -EINVAL;
+	mutex_lock(&liverpool_clk_lock);
+	liverpool_clk_read_state(adev, &s);
+	mutex_unlock(&liverpool_clk_lock);
+
+	seq_printf(m, "asic: %s\n", adev->asic_type == CHIP_LIVERPOOL ? "liverpool" : "gladius");
+	seq_printf(m, "restore_param: %d\n", ps4_sclk_restore);
+	seq_printf(m, "active_did: %u\n", liverpool_clk_active_did(&s));
+	seq_printf(m, "state: %s\n", liverpool_clk_active_did(&s) == LIVERPOOL_MAX_SCLK_DID ? "max" :
+		   liverpool_clk_active_did(&s) == s.startup_did ? "startup" : "other");
+	seq_printf(m, "startup_sclk_did_fuse: %u\n", s.startup_did);
+	seq_printf(m, "smc_startup_did: %u\n", s.smc_startup_did);
+	seq_printf(m, "cg_sclk_cntl: 0x%08x\n", s.cntl);
+	seq_printf(m, "cg_sclk_status: 0x%08x\n", s.status);
+	seq_printf(m, "sclk_divider: %u\n", (s.cntl & SCLK_DIVIDER_MASK) >> SCLK_DIVIDER_SHIFT);
+	seq_printf(m, "sclk_dircntl_en: %u\n", !!(s.cntl & SCLK_DIRCNTL_EN));
+	seq_printf(m, "sclk_dircntl_divider: %u\n", (s.cntl & SCLK_DIRCNTL_DIV_MASK) >> SCLK_DIRCNTL_DIV_SHIFT);
+	seq_printf(m, "spll_freq_id_startup: %u\n",
+		   (s.spll_fuses & SPLL_FREQ_ID_STARTUP_MASK) >> SPLL_FREQ_ID_STARTUP_SHIFT);
+	seq_printf(m, "spll_freq_id_max: %u\n", (s.spll_fuses & SPLL_FREQ_ID_MAX_MASK) >> SPLL_FREQ_ID_MAX_SHIFT);
+	seq_printf(m, "spll_pdiva: %u\n", s.pdiva);
+	seq_printf(m, "spll_fbdiv: 0x%x\n", s.fbdiv);
+	seq_printf(m, "spll_unlock_sticky: %u\n", !!(s.spll_status & SPLL_UNLOCK_STICKY));
+	return 0;
+}
+
+static ssize_t ps4_sclk_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct amdgpu_device *adev = drm_to_adev(dev_get_drvdata(dev));
+	struct liverpool_clk_state s;
+	u32 did;
+
+	mutex_lock(&liverpool_clk_lock);
+	liverpool_clk_read_state(adev, &s);
+	mutex_unlock(&liverpool_clk_lock);
+	did = liverpool_clk_active_did(&s);
+	return sysfs_emit(buf, "state=%s did=%u startup_did=%u dircntl=%u pdiva=%u fbdiv=0x%x "
+			  "spll_unlock_sticky=%u restore_param=%d\n",
+			  did == LIVERPOOL_MAX_SCLK_DID ? "max" : did == s.startup_did ? "startup" : "other",
+			  did, s.startup_did, !!(s.cntl & SCLK_DIRCNTL_EN), s.pdiva, s.fbdiv,
+			  !!(s.spll_status & SPLL_UNLOCK_STICKY), ps4_sclk_restore);
+}
+
+static ssize_t ps4_sclk_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct amdgpu_device *adev = drm_to_adev(dev_get_drvdata(dev));
+	struct liverpool_clk_state s;
+	int r;
+
+	if (sysfs_streq(buf, "max")) {
+		r = liverpool_clk_set_did(adev, LIVERPOOL_MAX_SCLK_DID, "sysfs max");
+	} else if (sysfs_streq(buf, "startup")) {
+		mutex_lock(&liverpool_clk_lock);
+		liverpool_clk_read_state(adev, &s);
+		r = liverpool_clk_set_did_locked(adev, s.startup_did, "sysfs startup");
+		mutex_unlock(&liverpool_clk_lock);
+	} else {
+		return -EINVAL;
+	}
+	return r ? r : count;
+}
+static DEVICE_ATTR_RW(ps4_sclk);
+
+void liverpool_clk_sysfs_init(struct amdgpu_device *adev)
+{
+	int r;
+
+	if (!liverpool_clk_is_ps4(adev) || liverpool_clk_sysfs_added)
+		return;
+	r = device_create_file(adev->dev, &dev_attr_ps4_sclk);
+	if (r)
+		dev_warn(adev->dev, "Liverpool CLK: cannot create ps4_sclk sysfs file: %d\n", r);
+	else
+		liverpool_clk_sysfs_added = true;
+}
+
+void liverpool_clk_sysfs_fini(struct amdgpu_device *adev)
+{
+	if (liverpool_clk_sysfs_added) {
+		device_remove_file(adev->dev, &dev_attr_ps4_sclk);
+		liverpool_clk_sysfs_added = false;
+	}
+}
