+/*
+ * NickLabs Orbis Graphics Engine 2.0: display robustness knobs, ported from the
+ * linux-psx 7.2-ps4 series (rmux: 0051, 0061, 0075, 0078, 0088, 0102, 0112) and
+ * re-expressed as parameters. Every default keeps the exact Orbis 0.2.0 behaviour;
+ * set them in bootargs.txt (amdgpu.ps4_bridge_*=N) for an A/B test, and read the
+ * outcome in /sys/kernel/debug/dri/0/ps4_bridge_status.
+ */
+static int ps4_bridge_dpcd_detect;
+module_param(ps4_bridge_dpcd_detect, int, 0644);
+MODULE_PARM_DESC(ps4_bridge_dpcd_detect,
+	"1=connected only if TMONREG HPD is set AND a DPCD AUX read succeeds (TMONREG HPD latches "
+	"high after the first plug); 0=TMONREG only (default)");
+
+static int ps4_bridge_poll;
+module_param(ps4_bridge_poll, int, 0444);
+MODULE_PARM_DESC(ps4_bridge_poll,
+	"1=let DRM poll the connector for plug/unplug (no HPD interrupt on Aeolia/Belize); 0=no (default)");
+
+static int ps4_bridge_enable_attempts = 1;
+module_param(ps4_bridge_enable_attempts, int, 0644);
+MODULE_PARM_DESC(ps4_bridge_enable_attempts,
+	"MN864729 video enable attempts, with a bridge reset between failures (1..5, default 1)");
+
+static int ps4_bridge_dpcd_wait_ms;
+module_param(ps4_bridge_dpcd_wait_ms, int, 0644);
+MODULE_PARM_DESC(ps4_bridge_dpcd_wait_ms,
+	"wait up to N ms for DPCD to answer before the MN864729 enable (0 = no wait, default; 3000 upstream)");
+
+static int ps4_bridge_retrain;
+module_param(ps4_bridge_retrain, int, 0644);
+MODULE_PARM_DESC(ps4_bridge_retrain,
+	"1=refresh DPCD and retrain the DP link once after a successful MN864729 enable; 0=no (default)");
+
+static int ps4_bridge_extra_modes;
+module_param(ps4_bridge_extra_modes, int, 0444);
+MODULE_PARM_DESC(ps4_bridge_extra_modes,
+	"1=also advertise 1280x720@60 (VIC 4) as a fallback mode; 0=1080p60 only (default)");
+
+#define PS4_BRIDGE_MAX_ENABLE_ATTEMPTS	5
+#define PS4_BRIDGE_RETRY_DELAY_MS	200
+
+/* outcome counters for diagnostics (debugfs ps4_bridge_status) */
+static struct {
+	int last_enable_ret;
+	int last_attempts;
+	unsigned int enables_ok, enables_failed, retrains, dpcd_waits_timed_out;
+	int last_dpcd_ret;
+	u8 last_tmonreg;
+	unsigned long last_enable_jiffies;
+} ps4_bridge_stats;
+
 #define CMD_READ	1, 1
 #define CMD_WRITE	2, 2
 #define CMD_MASK	2, 3
@@ -368,6 +423,93 @@ static inline struct ps4_bridge *
 	return container_of(bridge, struct ps4_bridge, bridge);
 }
 
+static int ps4_bridge_wait_dpcd_ready(struct ps4_bridge *mn_bridge, unsigned long timeout_ms)
+{
+	struct drm_connector *connector = mn_bridge->connector;
+	struct amdgpu_connector *amdgpu_connector;
+	struct amdgpu_connector_atom_dig *dig_connector;
+	unsigned long deadline;
+	int ret;
+
+	if (!connector)
+		return -ENODEV;
+	amdgpu_connector = to_amdgpu_connector(connector);
+	if (!amdgpu_connector->ddc_bus || !amdgpu_connector->ddc_bus->has_aux)
+		return 0;
+	dig_connector = amdgpu_connector->con_priv;
+	if (dig_connector)
+		dig_connector->dp_sink_type = CONNECTOR_OBJECT_ID_DISPLAYPORT;
+
+	deadline = jiffies + msecs_to_jiffies(timeout_ms);
+	do {
+		ret = amdgpu_atombios_dp_get_dpcd(amdgpu_connector);
+		if (ret == 0)
+			return 0;
+		msleep(20);
+	} while (time_before(jiffies, deadline));
+
+	ps4_bridge_stats.dpcd_waits_timed_out++;
+	DRM_WARN("ps4_bridge: DPCD not ready after %lu ms\n", timeout_ms);
+	return -ETIMEDOUT;
+}
+
+static void ps4_bridge_retrain_dp(struct ps4_bridge *mn_bridge)
+{
+	struct drm_connector *connector = mn_bridge->connector;
+	struct drm_encoder *encoder = mn_bridge->encoder;
+	struct amdgpu_connector *amdgpu_connector;
+	struct amdgpu_connector_atom_dig *dig_connector;
+	int ret;
+
+	if (!connector || !encoder)
+		return;
+	amdgpu_connector = to_amdgpu_connector(connector);
+	if (!amdgpu_connector->ddc_bus || !amdgpu_connector->ddc_bus->has_aux)
+		return;
+	dig_connector = amdgpu_connector->con_priv;
+	if (dig_connector)
+		dig_connector->dp_sink_type = CONNECTOR_OBJECT_ID_DISPLAYPORT;
+
+	ret = amdgpu_atombios_dp_get_dpcd(amdgpu_connector);
+	DRM_DEBUG_KMS("ps4_bridge: post-enable DPCD ret=%d\n", ret);
+	if (ret)
+		return;
+	DRM_DEBUG_KMS("ps4_bridge: retraining DP link after bridge enable\n");
+	amdgpu_atombios_dp_link_train(encoder, connector);
+	ps4_bridge_stats.retrains++;
+}
+
+/* caller holds mn_bridge->mutex */
+static void ps4_bridge_reset_mn864729_locked(struct ps4_bridge *mn_bridge)
+{
+	cq_init(&mn_bridge->cq, 4);
+	cq_writereg(&mn_bridge->cq, TSRST,
+		    TSRST_AVCSRST | TSRST_ENCSRST | TSRST_FIFOSRST |
+		    TSRST_CCSRST | TSRST_HDCPSRST | TSRST_AUDSRST | TSRST_VIFSRST);
+	if (cq_exec(&mn_bridge->cq) < 0)
+		DRM_ERROR("ps4_bridge: reset between MN864729 enable attempts failed\n");
+}
+
+static int ps4_bridge_status_show(struct seq_file *m, void *unused)
+{
+	seq_printf(m, "last_enable_ret: %d\n", ps4_bridge_stats.last_enable_ret);
+	seq_printf(m, "last_attempts: %d\n", ps4_bridge_stats.last_attempts);
+	seq_printf(m, "enables_ok: %u\n", ps4_bridge_stats.enables_ok);
+	seq_printf(m, "enables_failed: %u\n", ps4_bridge_stats.enables_failed);
+	seq_printf(m, "retrains: %u\n", ps4_bridge_stats.retrains);
+	seq_printf(m, "dpcd_waits_timed_out: %u\n", ps4_bridge_stats.dpcd_waits_timed_out);
+	seq_printf(m, "last_tmonreg: 0x%02x\n", ps4_bridge_stats.last_tmonreg);
+	seq_printf(m, "last_dpcd_ret: %d\n", ps4_bridge_stats.last_dpcd_ret);
+	seq_printf(m, "last_enable_age_ms: %u\n", ps4_bridge_stats.last_enable_jiffies ?
+		   jiffies_to_msecs(jiffies - ps4_bridge_stats.last_enable_jiffies) : 0);
+	seq_printf(m, "knobs: dpcd_detect=%d poll=%d enable_attempts=%d dpcd_wait_ms=%d retrain=%d "
+		   "extra_modes=%d mute_on_disable=%d force_unmute=%d fix_hdcpen=%d\n",
+		   ps4_bridge_dpcd_detect, ps4_bridge_poll, ps4_bridge_enable_attempts,
+		   ps4_bridge_dpcd_wait_ms, ps4_bridge_retrain, ps4_bridge_extra_modes,
+		   ps4_bridge_mute_on_disable, ps4_bridge_force_unmute, ps4_bridge_fix_hdcpen);
+	return 0;
+}
