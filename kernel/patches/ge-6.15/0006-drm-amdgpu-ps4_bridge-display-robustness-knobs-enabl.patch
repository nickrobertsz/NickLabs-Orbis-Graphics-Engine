--- a/drivers/gpu/drm/amd/amdgpu/atombios_dp.c
+++ b/drivers/gpu/drm/amd/amdgpu/atombios_dp.c
@@ -27,6 +27,7 @@
 
 #include <drm/amdgpu_drm.h>
 #include <drm/display/drm_dp_helper.h>
+#include <linux/moduleparam.h>
 
 #include "amdgpu.h"
 
@@ -493,6 +494,20 @@ void amdgpu_atombios_dp_set_rx_power_state(struct drm_connector *connector,
 	}
 }
 
+/*
+ * NickLabs Orbis Graphics Engine 2.0 (linux-psx 7.2-ps4 0132, rmux): the PS4 MN864729
+ * DP->HDMI bridge presents a fixed internal link; logs show clock-recovery / channel-EQ
+ * status polls failing although the link works. amdgpu.ps4_dp_fixed_link=1 skips those
+ * status polls (training patterns are still sent) on MN864729 consoles (not CUH-11xx).
+ * Default 0 keeps the Orbis 0.2.0 behaviour.
+ */
+static int ps4_dp_fixed_link;
+module_param(ps4_dp_fixed_link, int, 0644);
+MODULE_PARM_DESC(ps4_dp_fixed_link,
+	"PS4 MN864729: skip DP CR/EQ status polling during link training (0=no, default)");
+
+#define PS4_PCI_DEVICE_ID_CUH_11XX 0x9920
+
 struct amdgpu_atombios_dp_link_train_info {
 	struct amdgpu_device *adev;
 	struct drm_encoder *encoder;
@@ -500,6 +515,7 @@ struct amdgpu_atombios_dp_link_train_info {
 	int dp_clock;
 	int dp_lane_count;
 	bool tp3_supported;
+	bool skip_status_check;
 	u8 dpcd[DP_RECEIVER_CAP_SIZE];
 	u8 train_set[4];
 	u8 link_status[DP_LINK_STATUS_SIZE];
@@ -616,6 +632,11 @@ amdgpu_atombios_dp_link_train_cr(struct amdgpu_atombios_dp_link_train_info *dp_i
 
 	udelay(400);
 
+	if (dp_info->skip_status_check) {
+		DRM_DEBUG_KMS("dp cr: skipping status poll (ps4 mn864729 fixed link)\n");
+		return 0;
+	}
+
 	/* clock recovery loop */
 	clock_recovery = false;
 	dp_info->tries = 0;
@@ -682,6 +703,11 @@ amdgpu_atombios_dp_link_train_ce(struct amdgpu_atombios_dp_link_train_info *dp_i
 	else
 		amdgpu_atombios_dp_set_tp(dp_info, DP_TRAINING_PATTERN_2);
 
+	if (dp_info->skip_status_check) {
+		DRM_DEBUG_KMS("dp ce: skipping status poll (ps4 mn864729 fixed link)\n");
+		return 0;
+	}
+
 	/* channel equalization loop */
 	dp_info->tries = 0;
 	channel_eq = false;
@@ -765,6 +791,9 @@ void amdgpu_atombios_dp_link_train(struct drm_encoder *encoder,
 	dp_info.dp_lane_count = dig_connector->dp_lane_count;
 	dp_info.dp_clock = dig_connector->dp_clock;
 	dp_info.aux = &amdgpu_connector->ddc_bus->aux;
+	dp_info.skip_status_check = ps4_dp_fixed_link &&
+		(adev->asic_type == CHIP_LIVERPOOL || adev->asic_type == CHIP_GLADIUS) &&
+		adev->pdev->device != PS4_PCI_DEVICE_ID_CUH_11XX;
 
 	if (amdgpu_atombios_dp_link_train_init(&dp_info))
 		goto done;
