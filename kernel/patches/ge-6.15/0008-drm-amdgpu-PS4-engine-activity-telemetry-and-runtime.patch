diff --git a/drivers/gpu/drm/amd/amdgpu/liverpool_orbis.c b/drivers/gpu/drm/amd/amdgpu/liverpool_orbis.c
new file mode 100644
index 000000000..0c8c13dd9
--- /dev/null
+++ b/drivers/gpu/drm/amd/amdgpu/liverpool_orbis.c
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: MIT
+/*
+ * liverpool_orbis.c - NickLabs Orbis Graphics Engine 2.0 telemetry and memory budget
+ * for the PS4 Liverpool/Gladius GPU (CIK APU without powerplay).
+ *
+ * sysfs files on the GPU's PCI device (read by orbis-hwd / orbis-memd / orbis-debug):
+ *
+ *   orbis_engine_busy (ro)  engine activity sampled from GRBM_STATUS, SRBM_STATUS and
+ *                           SRBM_STATUS2 over a short window (200 samples, 100 us apart).
+ *                           Liverpool has no SMU activity counters under Linux, so this is
+ *                           the only first-hand utilisation source; the values are sampled
+ *                           busy fractions, not cycle counts.
+ *   orbis_gtt_budget (rw)   the GTT domain budget (bytes) that amdgpu enforces for new
+ *                           system-memory-backed GPU allocations. Raising it lets graphics
+ *                           and compute use more of the shared GDDR5 pool through GPUVM;
+ *                           lowering it below current use makes TTM evict GTT buffers to
+ *                           system pages instead of failing. Bounded by ttm.pages_limit
+ *                           (itself writable at runtime) and a 256 MiB floor.
+ *
+ * The VRAM carve-out size is fixed by the loader before Linux starts (vram.txt); only
+ * the GTT side of the unified pool can move at runtime.
+ */
+
+#include <linux/delay.h>
+#include <linux/sysfs.h>
+#include <drm/ttm/ttm_tt.h>
+#include <drm/ttm/ttm_resource.h>
+
+#include "amdgpu.h"
+#include "liverpool_orbis.h"
+
+#include "gca/gfx_7_2_d.h"
+#include "gca/gfx_7_2_sh_mask.h"
+#include "oss/oss_2_0_d.h"
+#include "oss/oss_2_0_sh_mask.h"
+
+#define ORBIS_BUSY_SAMPLES	200
+#define ORBIS_BUSY_STEP_US	100
+#define ORBIS_GTT_MIN_BYTES	(256ULL << 20)
+
+static bool liverpool_orbis_sysfs_added;
+
+static bool liverpool_orbis_is_ps4(struct amdgpu_device *adev)
+{
+	return adev->asic_type == CHIP_LIVERPOOL || adev->asic_type == CHIP_GLADIUS;
+}
+
+static ssize_t orbis_engine_busy_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct amdgpu_device *adev = drm_to_adev(dev_get_drvdata(dev));
+	unsigned int gui = 0, cp = 0, spi = 0, ta = 0, sdma0 = 0, sdma1 = 0, uvd = 0, mc = 0;
+	u32 grbm, srbm, srbm2;
+	int i;
+
+	if (amdgpu_in_reset(adev) || adev->in_suspend)
+		return -EBUSY;
+
+	for (i = 0; i < ORBIS_BUSY_SAMPLES; i++) {
+		grbm = RREG32(mmGRBM_STATUS);
+		srbm = RREG32(mmSRBM_STATUS);
+		srbm2 = RREG32(mmSRBM_STATUS2);
+		gui += !!(grbm & GRBM_STATUS__GUI_ACTIVE_MASK);
+		cp += !!(grbm & GRBM_STATUS__CP_BUSY_MASK);
+		spi += !!(grbm & GRBM_STATUS__SPI_BUSY_MASK);
+		ta += !!(grbm & GRBM_STATUS__TA_BUSY_MASK);
+		sdma0 += !!(srbm2 & SRBM_STATUS2__SDMA_BUSY_MASK);
+		sdma1 += !!(srbm2 & SRBM_STATUS2__SDMA1_BUSY_MASK);
+		uvd += !!(srbm & SRBM_STATUS__UVD_BUSY_MASK);
+		mc += !!(srbm & (SRBM_STATUS__VMC_BUSY_MASK | SRBM_STATUS__MCB_BUSY_MASK));
+		udelay(ORBIS_BUSY_STEP_US);
+	}
+
+#define PCT(x) ((x) * 100 / ORBIS_BUSY_SAMPLES)
+	return sysfs_emit(buf, "gfx=%u shader=%u texture=%u cp=%u sdma0=%u sdma1=%u uvd=%u mc=%u "
+			  "samples=%u window_us=%u\n",
+			  PCT(gui), PCT(spi), PCT(ta), PCT(cp), PCT(sdma0), PCT(sdma1), PCT(uvd), PCT(mc),
+			  ORBIS_BUSY_SAMPLES, ORBIS_BUSY_SAMPLES * ORBIS_BUSY_STEP_US);
+#undef PCT
+}
+static DEVICE_ATTR_RO(orbis_engine_busy);
+
+static ssize_t orbis_gtt_budget_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct amdgpu_device *adev = drm_to_adev(dev_get_drvdata(dev));
+	struct ttm_resource_manager *man = ttm_manager_type(&adev->mman.bdev, TTM_PL_TT);
+
+	return sysfs_emit(buf, "budget=%llu usage=%llu ttm_pages_limit=%llu min=%llu vram_carveout=%llu\n",
+			  READ_ONCE(man->size), ttm_resource_manager_usage(man),
+			  (u64)ttm_tt_pages_limit() << PAGE_SHIFT, ORBIS_GTT_MIN_BYTES,
+			  adev->gmc.real_vram_size);
+}
+
+static ssize_t orbis_gtt_budget_store(struct device *dev, struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct amdgpu_device *adev = drm_to_adev(dev_get_drvdata(dev));
+	struct ttm_resource_manager *man = ttm_manager_type(&adev->mman.bdev, TTM_PL_TT);
+	u64 val, limit = (u64)ttm_tt_pages_limit() << PAGE_SHIFT, old;
+	int r;
+
+	r = kstrtou64(buf, 0, &val);
+	if (r)
+		return r;
+	if (val < ORBIS_GTT_MIN_BYTES || val > limit)
+		return -ERANGE;
+	val = round_down(val, PAGE_SIZE);
+	old = READ_ONCE(man->size);
+	/* ttm_resource_manager.size is documented as constant; amdgpu only uses it as the
+	 * budget compared against usage in amdgpu_gtt_mgr_new() and for reporting, so a
+	 * new value applies to later allocations only. */
+	WRITE_ONCE(man->size, val);
+	dev_info(adev->dev, "Orbis: GTT budget %llu MiB -> %llu MiB (usage %llu MiB)\n",
+		 old >> 20, val >> 20, ttm_resource_manager_usage(man) >> 20);
+	return count;
+}
+static DEVICE_ATTR_RW(orbis_gtt_budget);
+
+static struct attribute *liverpool_orbis_attrs[] = {
+	&dev_attr_orbis_engine_busy.attr,
+	&dev_attr_orbis_gtt_budget.attr,
+	NULL,
+};
+
+static const struct attribute_group liverpool_orbis_group = {
+	.attrs = liverpool_orbis_attrs,
+};
+
+void liverpool_orbis_sysfs_init(struct amdgpu_device *adev)
+{
+	int r;
+
+	if (!liverpool_orbis_is_ps4(adev) || liverpool_orbis_sysfs_added)
+		return;
+	r = sysfs_create_group(&adev->dev->kobj, &liverpool_orbis_group);
+	if (r)
+		dev_warn(adev->dev, "Orbis: cannot create telemetry sysfs files: %d\n", r);
+	else
+		liverpool_orbis_sysfs_added = true;
+}
+
+void liverpool_orbis_sysfs_fini(struct amdgpu_device *adev)
+{
+	if (liverpool_orbis_sysfs_added) {
+		sysfs_remove_group(&adev->dev->kobj, &liverpool_orbis_group);
+		liverpool_orbis_sysfs_added = false;
+	}
+}
diff --git a/drivers/gpu/drm/amd/amdgpu/liverpool_orbis.h b/drivers/gpu/drm/amd/amdgpu/liverpool_orbis.h
new file mode 100644
index 000000000..c253ac7fc
--- /dev/null
+++ b/drivers/gpu/drm/amd/amdgpu/liverpool_orbis.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef LIVERPOOL_ORBIS_H
+#define LIVERPOOL_ORBIS_H
+
+struct amdgpu_device;
+
+#ifdef CONFIG_DRM_AMDGPU_CIK
+void liverpool_orbis_sysfs_init(struct amdgpu_device *adev);
+void liverpool_orbis_sysfs_fini(struct amdgpu_device *adev);
+#else
+static inline void liverpool_orbis_sysfs_init(struct amdgpu_device *adev) { }
+static inline void liverpool_orbis_sysfs_fini(struct amdgpu_device *adev) { }
+#endif
+
+#endif
