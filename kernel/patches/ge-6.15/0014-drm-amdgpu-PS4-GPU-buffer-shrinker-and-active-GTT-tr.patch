+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.h
@@ -50,6 +50,8 @@ struct amdgpu_gtt_mgr {
 	spinlock_t lock;
 };
 
+struct amdgpu_orbis_shrinker;
+
 struct amdgpu_mman {
 	struct ttm_device		bdev;
 	struct ttm_pool			*ttm_pools;
@@ -69,6 +71,8 @@ struct amdgpu_mman {
 
 	struct amdgpu_vram_mgr vram_mgr;
 	struct amdgpu_gtt_mgr gtt_mgr;
+	/* NickLabs Orbis ge-0014: PS4 GPU buffer shrinker, NULL when disabled */
+	struct amdgpu_orbis_shrinker *orbis_shrinker;
 	struct ttm_resource_manager preempt_mgr;
 
 	uint64_t		stolen_vga_size;
diff --git a/drivers/gpu/drm/amd/amdgpu/liverpool_orbis.c b/drivers/gpu/drm/amd/amdgpu/liverpool_orbis.c
index 0c8c13dd9..84b8b8f72 100644
--- a/drivers/gpu/drm/amd/amdgpu/liverpool_orbis.c
+++ b/drivers/gpu/drm/amd/amdgpu/liverpool_orbis.c
@@ -16,6 +16,11 @@
  *                           lowering it below current use makes TTM evict GTT buffers to
  *                           system pages instead of failing. Bounded by ttm.pages_limit
  *                           (itself writable at runtime) and a 256 MiB floor.
+ *                           ge-0014: a value below current usage now trims at once
+ *                           (GTT buffers are evicted in LRU order until usage fits).
+ *   orbis_gtt_reclaim (rw)  ge-0014 shrinker counters (see liverpool_orbis_shrinker.c);
+ *                           writing "scan <pages> [writeback]" runs one reclaim pass for
+ *                           verification without waiting for memory pressure.
  *
  * The VRAM carve-out size is fixed by the loader before Linux starts (vram.txt); only
  * the GTT side of the unified pool can move at runtime.
@@ -28,6 +33,7 @@
 
 #include "amdgpu.h"
 #include "liverpool_orbis.h"
+#include "liverpool_orbis_shrinker.h"
 
 #include "gca/gfx_7_2_d.h"
 #include "gca/gfx_7_2_sh_mask.h"
@@ -111,13 +117,49 @@ static ssize_t orbis_gtt_budget_store(struct device *dev, struct device_attribut
 	WRITE_ONCE(man->size, val);
 	dev_info(adev->dev, "Orbis: GTT budget %llu MiB -> %llu MiB (usage %llu MiB)\n",
 		 old >> 20, val >> 20, ttm_resource_manager_usage(man) >> 20);
+
+	/* ge-0014 active trim: do not wait for the next allocation to enforce a lower budget */
+	if (ttm_resource_manager_usage(man) > val) {
+		unsigned int evicted = 0;
+		long tr = amdgpu_orbis_gtt_trim(adev, val, &evicted);
+
+		dev_info(adev->dev, "Orbis: GTT trim evicted %u buffers, usage now %llu MiB%s\n",
+			 evicted, ttm_resource_manager_usage(man) >> 20,
+			 tr ? " (stopped early)" : "");
+		if (tr == -ERESTARTSYS || tr == -EINTR)
+			return tr;
+	}
 	return count;
 }
 static DEVICE_ATTR_RW(orbis_gtt_budget);
 
+static ssize_t orbis_gtt_reclaim_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return amdgpu_orbis_shrinker_report(drm_to_adev(dev_get_drvdata(dev)), buf);
+}
+
+static ssize_t orbis_gtt_reclaim_store(struct device *dev, struct device_attribute *attr,
+				       const char *buf, size_t count)
+{
+	struct amdgpu_device *adev = drm_to_adev(dev_get_drvdata(dev));
+	unsigned long pages;
+	char wb[16] = "";
+	long freed;
+
+	if (sscanf(buf, "scan %lu %15s", &pages, wb) < 1 || !pages)
+		return -EINVAL;
+	freed = amdgpu_orbis_shrinker_scan(adev, pages, !strcmp(wb, "writeback"));
+	if (freed < 0)
+		return freed;
+	dev_info(adev->dev, "Orbis: reclaim scan of %lu pages: %ld backed up or purged\n", pages, freed);
+	return count;
+}
+static DEVICE_ATTR_RW(orbis_gtt_reclaim);
+
 static struct attribute *liverpool_orbis_attrs[] = {
 	&dev_attr_orbis_engine_busy.attr,
 	&dev_attr_orbis_gtt_budget.attr,
+	&dev_attr_orbis_gtt_reclaim.attr,
 	NULL,
 };
 
diff --git a/drivers/gpu/drm/amd/amdgpu/liverpool_orbis_shrinker.c b/drivers/gpu/drm/amd/amdgpu/liverpool_orbis_shrinker.c
new file mode 100644
index 000000000..b80c85d35
--- /dev/null
+++ b/drivers/gpu/drm/amd/amdgpu/liverpool_orbis_shrinker.c
@@ -0,0 +1,339 @@
+// SPDX-License-Identifier: MIT
+/*
+ * liverpool_orbis_shrinker.c - NickLabs Orbis ge-0014: reclaimable GPU buffers on the PS4.
+ *
+ * The PS4 CPU and GPU share one GDDR5 pool. GPU buffers in the GTT and SYSTEM domains are
+ * ordinary Linux pages, but upstream amdgpu (6.15) never gives them back under memory
+ * pressure: its only path is TTM's swapout when ttm.pages_limit is exceeded, at allocation
+ * time. An idle game texture therefore pins RAM until the process exits or the OOM killer runs.
+ *
+ * This file registers a memory shrinker that uses the TTM backup helpers added for xe in
+ * 6.15 (ttm_bo_shrink, ttm_tt_setup_backup, ttm_backup shmem):
+ *
+ *  - eligible buffers (user buffers, not imported/exported dma-bufs, not userptr, not pinned,
+ *    idle or waitable) are moved to SYSTEM (GART unbind, VM invalidation through the normal
+ *    move path) and their pages are copied into a per-buffer shmem object, then freed;
+ *  - shmem pages are ordinary swappable pages: kswapd writes them to swap (zram on Orbis)
+ *    like any other anonymous memory. Only then is RAM actually compressed or freed. Moving
+ *    a buffer out of GTT by itself frees nothing, which is why trimming (below) and this
+ *    shrinker work together;
+ *  - AMDGPU_GEM_CREATE_DISCARDABLE buffers are purged (content dropped) instead;
+ *  - the next CPU fault or GPU validation repopulates the buffer from shmem
+ *    (amdgpu_ttm_tt_populate -> ttm_tt_restore).
+ *
+ * Active trim: writing a lower orbis_gtt_budget evicts GTT buffers (LRU order) until usage is
+ * within the budget, instead of waiting for the next allocation.
+ *
+ * Off by default (amdgpu.orbis_shrinker=1 on the kernel command line enables it, PS4 only):
+ * the backup capability must be set when a buffer's page table is created, so it cannot be
+ * switched at runtime. Counters: sysfs orbis_gtt_reclaim on the GPU's PCI device.
+ *
+ * Status: written against the pinned 6.15.4 TTM interfaces; not compiled or tested here.
+ */
+
+#include <linux/shrinker.h>
+#include <linux/sysfs.h>
+#include <linux/swap.h>
+#include <drm/ttm/ttm_backup.h>
+#include <drm/ttm/ttm_bo.h>
+#include <drm/ttm/ttm_tt.h>
+
+#include "amdgpu.h"
+#include "liverpool_orbis_shrinker.h"
+
+static int amdgpu_orbis_shrinker_param;
+module_param_named(orbis_shrinker, amdgpu_orbis_shrinker_param, int, 0444);
+MODULE_PARM_DESC(orbis_shrinker,
+		 "PS4 (NickLabs Orbis): make idle GPU buffers reclaimable under memory pressure (0 = off (default), 1 = on)");
+
+#define ORBIS_TRIM_MAX_EVICTIONS	8192
+
+struct amdgpu_orbis_shrinker {
+	struct amdgpu_device *adev;
+	struct shrinker *shrink;
+	/* populated, backup-capable pages (an upper bound: busy or pinned buffers are included) */
+	atomic_long_t shrinkable_pages;
+	atomic_long_t purgeable_pages;
+	/* pages currently held in shmem backups instead of GPU page arrays */
+	atomic_long_t backed_up_pages;
+	atomic64_t shrunk_total;
+	atomic64_t purged_total;
+	atomic64_t restored_total;
+	atomic64_t scans;
+	atomic64_t trim_evictions;
+};
+
+static struct amdgpu_orbis_shrinker *to_orbis(struct amdgpu_device *adev)
+{
+	return adev->mman.orbis_shrinker;
+}
+
+static bool amdgpu_orbis_is_ps4(struct amdgpu_device *adev)
+{
+	return adev->asic_type == CHIP_LIVERPOOL || adev->asic_type == CHIP_GLADIUS;
+}
+
+bool amdgpu_orbis_shrinker_tt_eligible(struct amdgpu_device *adev, struct ttm_buffer_object *bo)
+{
+	if (!to_orbis(adev))
+		return false;
+	/* user buffers only: kernel buffers (rings, page tables, firmware) are never shrunk,
+	 * and sg buffers are imported dma-bufs whose pages belong to the exporter */
+	if (bo->type != ttm_bo_type_device)
+		return false;
+	return true;
+}
+
+void amdgpu_orbis_shrinker_account(struct amdgpu_device *adev, bool purgeable, long pages)
+{
+	struct amdgpu_orbis_shrinker *s = to_orbis(adev);
+
+	if (!s)
+		return;
+	atomic_long_add(pages, purgeable ? &s->purgeable_pages : &s->shrinkable_pages);
+}
+
+void amdgpu_orbis_shrinker_shrunk(struct amdgpu_device *adev, bool purged, long pages)
+{
+	struct amdgpu_orbis_shrinker *s = to_orbis(adev);
+
+	if (!s || pages <= 0)
+		return;
+	if (purged) {
+		atomic64_add(pages, &s->purged_total);
+	} else {
+		atomic64_add(pages, &s->shrunk_total);
+		atomic_long_add(pages, &s->backed_up_pages);
+	}
+}
+
+void amdgpu_orbis_shrinker_restored(struct amdgpu_device *adev, long pages)
+{
+	struct amdgpu_orbis_shrinker *s = to_orbis(adev);
+
+	if (!s || pages <= 0)
+		return;
+	atomic64_add(pages, &s->restored_total);
+	atomic_long_sub(pages, &s->backed_up_pages);
+}
+
+void amdgpu_orbis_shrinker_dropped(struct amdgpu_device *adev, long pages)
+{
+	struct amdgpu_orbis_shrinker *s = to_orbis(adev);
+
+	if (!s || pages <= 0)
+		return;
+	atomic_long_sub(pages, &s->backed_up_pages);
+}
+
+static long amdgpu_orbis_walk(struct amdgpu_orbis_shrinker *s, struct ttm_operation_ctx *ctx,
+			      bool purge, bool writeback, unsigned long to_scan,
+			      unsigned long *scanned)
+{
+	static const unsigned int mem_types[] = { TTM_PL_SYSTEM, TTM_PL_TT };
+	struct ttm_device *bdev = &s->adev->mman.bdev;
+	long freed = 0, lret;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(mem_types) && *scanned < to_scan; i++) {
+		struct ttm_resource_manager *man = ttm_manager_type(bdev, mem_types[i]);
+		struct ttm_bo_lru_cursor curs;
+		struct ttm_buffer_object *bo;
+
+		if (!man || !man->use_tt)
+			continue;
+
+		/* trylock only (shrinker context): contended buffers are skipped */
+		ttm_bo_lru_for_each_reserved_guarded(&curs, man, ctx, bo) {
+			if (!ttm_bo_shrink_suitable(bo, ctx))
+				continue;
+
+			lret = amdgpu_ttm_orbis_shrink_bo(ctx, bo, purge, writeback, scanned);
+			if (lret == -EINTR || lret == -ERESTARTSYS)
+				return freed ? freed : lret;
+			if (lret > 0)
+				freed += lret;
+			/* -EBUSY / -ENOSPC / -ENOMEM: not this buffer, try the next one */
+			if (*scanned >= to_scan)
+				break;
+		}
+	}
+	return freed;
+}
+
+static unsigned long amdgpu_orbis_count(struct shrinker *shrink, struct shrink_control *sc)
+{
+	struct amdgpu_orbis_shrinker *s = shrink->private_data;
+	long shrinkable = max(0L, atomic_long_read(&s->shrinkable_pages));
+	long purgeable = max(0L, atomic_long_read(&s->purgeable_pages));
+	unsigned long n = 0;
+
+	/* backing up needs to write to shmem (__GFP_FS); purging does not */
+	if (sc->gfp_mask & __GFP_FS)
+		n = min_t(unsigned long, ttm_backup_bytes_avail() >> PAGE_SHIFT, shrinkable);
+	n += purgeable;
+
+	return n ? n : SHRINK_EMPTY;
+}
+
+static unsigned long amdgpu_orbis_scan(struct shrinker *shrink, struct shrink_control *sc)
+{
+	struct amdgpu_orbis_shrinker *s = shrink->private_data;
+	struct ttm_operation_ctx ctx = {
+		.interruptible = false,
+		/* direct reclaim must not wait for the GPU; kswapd may */
+		.no_wait_gpu = ttm_bo_shrink_avoid_wait(),
+	};
+	bool can_backup = !!(sc->gfp_mask & __GFP_FS);
+	/* ask for immediate writeout to swap only where I/O is allowed */
+	bool writeback = !ctx.no_wait_gpu && (sc->gfp_mask & __GFP_IO);
+	unsigned long scanned = 0, freed = 0;
+	long lret;
+
+	atomic64_inc(&s->scans);
+
+	/* discardable buffers first: dropping them costs nothing */
+	if (atomic_long_read(&s->purgeable_pages) > 0) {
+		lret = amdgpu_orbis_walk(s, &ctx, true, false, sc->nr_to_scan, &scanned);
+		if (lret > 0)
+			freed += lret;
+	}
+
+	if (scanned < sc->nr_to_scan && can_backup) {
+		lret = amdgpu_orbis_walk(s, &ctx, false, writeback, sc->nr_to_scan, &scanned);
+		if (lret > 0)
+			freed += lret;
+	}
+
+	sc->nr_scanned = scanned;
+	return scanned ? freed : SHRINK_STOP;
+}
+
+/* Manual scan for verification (sysfs "scan <pages>"): process context, may wait for the GPU. */
+long amdgpu_orbis_shrinker_scan(struct amdgpu_device *adev, unsigned long nr_pages, bool writeback)
+{
+	struct amdgpu_orbis_shrinker *s = to_orbis(adev);
+	struct ttm_operation_ctx ctx = { .interruptible = true, .no_wait_gpu = false };
+	unsigned long scanned = 0;
+	long freed = 0, lret;
+
+	if (!s)
+		return -ENODEV;
+	atomic64_inc(&s->scans);
+	lret = amdgpu_orbis_walk(s, &ctx, true, false, nr_pages, &scanned);
+	if (lret < 0)
+		return lret;
+	freed += lret;
+	if (scanned < nr_pages) {
+		lret = amdgpu_orbis_walk(s, &ctx, false, writeback, nr_pages, &scanned);
+		if (lret < 0)
+			return freed ? freed : lret;
+		freed += lret;
+	}
+	return freed;
+}
+
+/*
+ * Active trim: evict GTT buffers in LRU order until the GTT manager's usage is at or below
+ * target_bytes. Evicted buffers land in SYSTEM (still RAM, no longer GPU-mapped); with the
+ * shrinker enabled they become reclaimable there. Returns 0, or a negative error when the
+ * walk stopped early (e.g. a signal, or a buffer that could not be moved).
+ */
+long amdgpu_orbis_gtt_trim(struct amdgpu_device *adev, u64 target_bytes, unsigned int *evicted)
+{
+	struct ttm_device *bdev = &adev->mman.bdev;
+	struct ttm_resource_manager *man = ttm_manager_type(bdev, TTM_PL_TT);
+	struct ttm_operation_ctx ctx = { .interruptible = true, .no_wait_gpu = false };
+	struct amdgpu_orbis_shrinker *s = to_orbis(adev);
+	unsigned int n = 0;
+	int r = 0;
+
+	*evicted = 0;
+	if (!man)
+		return -ENODEV;
+
+	while (ttm_resource_manager_usage(man) > target_bytes && n < ORBIS_TRIM_MAX_EVICTIONS) {
+		r = ttm_bo_evict_first(bdev, man, &ctx);
+		if (r)
+			break;
+		n++;
+		cond_resched();
+	}
+	*evicted = n;
+	if (s)
+		atomic64_add(n, &s->trim_evictions);
+	if (r == -ENOENT)
+		r = 0;
+	return r;
+}
+
+ssize_t amdgpu_orbis_shrinker_report(struct amdgpu_device *adev, char *buf)
+{
+	struct amdgpu_orbis_shrinker *s = to_orbis(adev);
+
+	if (!s)
+		return sysfs_emit(buf, "enabled=0 reason=%s\n",
+				  !amdgpu_orbis_shrinker_param ? "off(amdgpu.orbis_shrinker=0)" :
+				  adev->mman.ttm_pools ? "partitioned-pools" :
+				  adev->mman.bdev.pool.use_dma_alloc ? "dma-alloc-pool" : "unsupported");
+
+	return sysfs_emit(buf,
+			  "enabled=1 shrinkable_pages=%ld purgeable_pages=%ld backed_up_pages=%ld "
+			  "shrunk_total=%lld purged_total=%lld restored_total=%lld scans=%lld "
+			  "trim_evictions=%lld backup_bytes_avail=%llu page_size=%lu\n",
+			  max(0L, atomic_long_read(&s->shrinkable_pages)),
+			  max(0L, atomic_long_read(&s->purgeable_pages)),
+			  max(0L, atomic_long_read(&s->backed_up_pages)),
+			  (long long)atomic64_read(&s->shrunk_total),
+			  (long long)atomic64_read(&s->purged_total),
+			  (long long)atomic64_read(&s->restored_total),
+			  (long long)atomic64_read(&s->scans),
+			  (long long)atomic64_read(&s->trim_evictions),
+			  (unsigned long long)ttm_backup_bytes_avail(), PAGE_SIZE);
+}
+
+void amdgpu_orbis_shrinker_init(struct amdgpu_device *adev)
+{
+	struct amdgpu_orbis_shrinker *s;
+
+	adev->mman.orbis_shrinker = NULL;
+	if (!amdgpu_orbis_shrinker_param || !amdgpu_orbis_is_ps4(adev))
+		return;
+	/* ttm_tt_backup()/ttm_tt_restore() use the device's default pool */
+	if (adev->mman.ttm_pools || adev->mman.bdev.pool.use_dma_alloc) {
+		dev_info(adev->dev, "Orbis: GPU buffer shrinker not available with this TTM pool setup\n");
+		return;
+	}
+
+	s = kzalloc(sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return;
+	s->shrink = shrinker_alloc(0, "drm-amdgpu-orbis:%s", adev_to_drm(adev)->unique ?: "ps4");
+	if (!s->shrink) {
+		kfree(s);
+		return;
+	}
+	s->adev = adev;
+	atomic_long_set(&s->shrinkable_pages, 0);
+	atomic_long_set(&s->purgeable_pages, 0);
+	atomic_long_set(&s->backed_up_pages, 0);
+	s->shrink->count_objects = amdgpu_orbis_count;
+	s->shrink->scan_objects = amdgpu_orbis_scan;
+	s->shrink->private_data = s;
+	/* publish before buffers are created: eligibility checks this pointer */
+	adev->mman.orbis_shrinker = s;
+	shrinker_register(s->shrink);
+	dev_info(adev->dev, "Orbis: GPU buffer shrinker enabled (idle GTT/system buffers reclaimable via shmem/swap)\n");
+}
+
+void amdgpu_orbis_shrinker_fini(struct amdgpu_device *adev)
+{
+	struct amdgpu_orbis_shrinker *s = to_orbis(adev);
+
+	if (!s)
+		return;
+	/* stops scans and waits for running ones; buffers keep their backups until freed */
+	shrinker_free(s->shrink);
+	adev->mman.orbis_shrinker = NULL;
+	kfree(s);
+}
