+						     struct ttm_buffer_object *bo) { return false; }
+static inline void amdgpu_orbis_shrinker_account(struct amdgpu_device *adev, bool purgeable, long pages) { }
+static inline void amdgpu_orbis_shrinker_restored(struct amdgpu_device *adev, long pages) { }
+static inline void amdgpu_orbis_shrinker_dropped(struct amdgpu_device *adev, long pages) { }
+static inline void amdgpu_orbis_shrinker_shrunk(struct amdgpu_device *adev, bool purged, long pages) { }
+#endif
