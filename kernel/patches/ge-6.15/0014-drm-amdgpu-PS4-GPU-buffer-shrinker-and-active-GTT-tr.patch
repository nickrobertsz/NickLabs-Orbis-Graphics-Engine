+ * NickLabs Orbis ge-0014: reclaimable GPU buffers on the PS4 (Liverpool/Gladius).
+ */
+#ifndef LIVERPOOL_ORBIS_SHRINKER_H
+#define LIVERPOOL_ORBIS_SHRINKER_H
+
+#include <linux/types.h>
+
+struct amdgpu_device;
+struct ttm_buffer_object;
+struct ttm_operation_ctx;
+
+#ifdef CONFIG_DRM_AMDGPU_CIK
+void amdgpu_orbis_shrinker_init(struct amdgpu_device *adev);
+void amdgpu_orbis_shrinker_fini(struct amdgpu_device *adev);
+bool amdgpu_orbis_shrinker_tt_eligible(struct amdgpu_device *adev, struct ttm_buffer_object *bo);
+void amdgpu_orbis_shrinker_account(struct amdgpu_device *adev, bool purgeable, long pages);
+void amdgpu_orbis_shrinker_restored(struct amdgpu_device *adev, long pages);
+void amdgpu_orbis_shrinker_dropped(struct amdgpu_device *adev, long pages);
+void amdgpu_orbis_shrinker_shrunk(struct amdgpu_device *adev, bool purged, long pages);
+long amdgpu_orbis_shrinker_scan(struct amdgpu_device *adev, unsigned long nr_pages, bool writeback);
+long amdgpu_orbis_gtt_trim(struct amdgpu_device *adev, u64 target_bytes, unsigned int *evicted);
+ssize_t amdgpu_orbis_shrinker_report(struct amdgpu_device *adev, char *buf);
+#else
+static inline void amdgpu_orbis_shrinker_init(struct amdgpu_device *adev) { }
