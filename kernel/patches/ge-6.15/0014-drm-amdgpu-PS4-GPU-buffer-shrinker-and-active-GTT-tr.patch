+	/*
+	 * NickLabs Orbis ge-0014 (PS4 shrinker). orbis_backup: the tt is backup-capable
+	 * (TTM_TT_FLAG_EXTERNAL | TTM_TT_FLAG_EXTERNAL_MAPPABLE, shmem backup attached).
+	 * orbis_accounted: its populated pages are counted as shrinkable/purgeable.
+	 * orbis_purged: the pages were dropped (discardable buffer), not backed up.
+	 * orbis_backed_pages: pages currently held in the shmem backup.
+	 */
+	bool			orbis_backup;
+	bool			orbis_purgeable;
+	bool			orbis_accounted;
+	bool			orbis_purged;
+	long			orbis_backed_pages;
 };
 
 #define ttm_to_amdgpu_ttm_tt(ptr)	container_of(ptr, struct amdgpu_ttm_tt, ttm)
@@ -937,7 +950,8 @@ static int amdgpu_ttm_backend_bind(struct ttm_device *bdev,
 			DRM_ERROR("failed to pin userptr\n");
 			return r;
 		}
-	} else if (ttm->page_flags & TTM_TT_FLAG_EXTERNAL) {
+	} else if ((ttm->page_flags & TTM_TT_FLAG_EXTERNAL) &&
+		   !(ttm->page_flags & TTM_TT_FLAG_EXTERNAL_MAPPABLE)) {
 		if (!ttm->sg) {
 			struct dma_buf_attachment *attach;
 			struct sg_table *sgt;
@@ -1087,6 +1101,10 @@ static void amdgpu_ttm_backend_destroy(struct ttm_device *bdev,
 	if (gtt->usertask)
 		put_task_struct(gtt->usertask);
 
+	/* a backed-up buffer freed without being restored: ttm_tt_fini drops the backup */
+	if (gtt->orbis_backed_pages)
+		amdgpu_orbis_shrinker_dropped(amdgpu_ttm_adev(bdev), gtt->orbis_backed_pages);
+
 	ttm_tt_fini(&gtt->ttm);
 	kfree(gtt);
 }
@@ -1127,6 +1145,23 @@ static struct ttm_tt *amdgpu_ttm_tt_create(struct ttm_buffer_object *bo,
 		kfree(gtt);
 		return NULL;
 	}
+
+	/*
+	 * NickLabs Orbis ge-0014: on the PS4, user buffers get a shmem backup so the shrinker can
+	 * reclaim them. The flags are set after ttm_sg_tt_init() so the tt keeps its page array
+	 * (EXTERNAL at init time would allocate a dma-address-only directory). With
+	 * EXTERNAL_MAPPABLE, TTM leaves the pages to us (no TTM swapout or pages_limit
+	 * accounting) but still maps them for the CPU.
+	 */
+	if (amdgpu_orbis_shrinker_tt_eligible(adev, bo)) {
+		gtt->ttm.page_flags |= TTM_TT_FLAG_EXTERNAL | TTM_TT_FLAG_EXTERNAL_MAPPABLE;
+		if (ttm_tt_setup_backup(&gtt->ttm)) {
+			gtt->ttm.page_flags &= ~(TTM_TT_FLAG_EXTERNAL | TTM_TT_FLAG_EXTERNAL_MAPPABLE);
+		} else {
+			gtt->orbis_backup = true;
+			gtt->orbis_purgeable = !!(abo->flags & AMDGPU_GEM_CREATE_DISCARDABLE);
+		}
+	}
 	return &gtt->ttm;
 }
 
@@ -1154,20 +1189,42 @@ static int amdgpu_ttm_tt_populate(struct ttm_device *bdev,
 		return 0;
 	}
 
-	if (ttm->page_flags & TTM_TT_FLAG_EXTERNAL)
+	/* imported dma-bufs: pages belong to the exporter */
+	if ((ttm->page_flags & TTM_TT_FLAG_EXTERNAL) &&
+	    !(ttm->page_flags & TTM_TT_FLAG_EXTERNAL_MAPPABLE))
 		return 0;
 
 	if (adev->mman.ttm_pools && gtt->pool_id >= 0)
 		pool = &adev->mman.ttm_pools[gtt->pool_id];
 	else
 		pool = &adev->mman.bdev.pool;
-	ret = ttm_pool_alloc(pool, ttm, ctx);
-	if (ret)
-		return ret;
+
+	if (gtt->orbis_backup && ttm_tt_is_backed_up(ttm) && !gtt->orbis_purged) {
+		/* ge-0014: read the content back from the shmem backup (default pool only) */
+		ret = ttm_tt_restore(bdev, ttm, ctx);
+		if (ret)
+			return ret;
+		amdgpu_orbis_shrinker_restored(adev, gtt->orbis_backed_pages);
+		gtt->orbis_backed_pages = 0;
+	} else {
+		if (gtt->orbis_backup && ttm_tt_is_backed_up(ttm)) {
+			/* purged discardable buffer: its content was given up, start fresh */
+			ttm_tt_clear_backed_up(ttm);
+			gtt->orbis_purged = false;
+		}
+		ret = ttm_pool_alloc(pool, ttm, ctx);
+		if (ret)
+			return ret;
+	}
 
 	for (i = 0; i < ttm->num_pages; ++i)
 		ttm->pages[i]->mapping = bdev->dev_mapping;
 
+	if (gtt->orbis_backup && !gtt->orbis_accounted) {
+		amdgpu_orbis_shrinker_account(adev, gtt->orbis_purgeable, ttm->num_pages);
+		gtt->orbis_accounted = true;
+	}
+
 	return 0;
 }
 
@@ -1187,6 +1244,12 @@ static void amdgpu_ttm_tt_unpopulate(struct ttm_device *bdev,
 
 	amdgpu_ttm_backend_unbind(bdev, ttm);
 
+	if (gtt->orbis_accounted) {
+		amdgpu_orbis_shrinker_account(amdgpu_ttm_adev(bdev), gtt->orbis_purgeable,
+					      -(long)ttm->num_pages);
+		gtt->orbis_accounted = false;
+	}
+
 	if (gtt->userptr) {
 		amdgpu_ttm_tt_set_user_pages(ttm, NULL);
 		kfree(ttm->sg);
@@ -1194,7 +1257,8 @@ static void amdgpu_ttm_tt_unpopulate(struct ttm_device *bdev,
 		return;
 	}
 
-	if (ttm->page_flags & TTM_TT_FLAG_EXTERNAL)
+	if ((ttm->page_flags & TTM_TT_FLAG_EXTERNAL) &&
+	    !(ttm->page_flags & TTM_TT_FLAG_EXTERNAL_MAPPABLE))
 		return;
 
 	for (i = 0; i < ttm->num_pages; ++i)
@@ -1210,6 +1274,78 @@ static void amdgpu_ttm_tt_unpopulate(struct ttm_device *bdev,
 	return ttm_pool_free(pool, ttm);
 }
 
+static bool amdgpu_ttm_bo_eviction_valuable(struct ttm_buffer_object *bo,
+					    const struct ttm_place *place);
+
+/**
+ * amdgpu_ttm_orbis_shrink_bo - NickLabs Orbis ge-0014: back up or purge one buffer
+ * @ctx: operation context of the shrinker walk
+ * @bo: buffer object, reserved and referenced by the caller (LRU cursor)
+ * @purge: drop the content (AMDGPU_GEM_CREATE_DISCARDABLE buffers only)
+ * @writeback: ask for immediate writeout of the backup to swap
+ * @scanned: incremented by the pages examined
+ *
+ * Moves the buffer to SYSTEM through ttm_bo_shrink() (the regular TT->SYSTEM move: VM
+ * invalidation via move_notify, GART unbind) and backs its pages up into shmem, or purges
+ * them. Imported or exported dma-bufs, userptr buffers, kernel buffers and TTM ghost objects
+ * are never touched. Returns pages backed up/purged, or a negative error (-EBUSY: skip).
+ */
+long amdgpu_ttm_orbis_shrink_bo(struct ttm_operation_ctx *ctx, struct ttm_buffer_object *bo,
+				bool purge, bool writeback, unsigned long *scanned)
+{
+	struct ttm_place place = { .mem_type = bo->resource->mem_type };
+	struct amdgpu_device *adev = amdgpu_ttm_adev(bo->bdev);
+	struct ttm_tt *ttm = bo->ttm;
+	struct amdgpu_ttm_tt *gtt;
+	pgoff_t i;
+	long lret;
+
+	if (!ttm || !(ttm->page_flags & TTM_TT_FLAG_EXTERNAL_MAPPABLE))
+		return -EBUSY;
+	gtt = ttm_to_amdgpu_ttm_tt(ttm);
+	if (!gtt->orbis_backup || gtt->userptr || purge != gtt->orbis_purgeable)
+		return -EBUSY;
+	/* ghost objects from pipelined moves are not amdgpu_bos: TTM frees them itself */
+	if (!amdgpu_bo_is_amdgpu_bo(bo))
+		return -EBUSY;
+	/* shared with another driver or process through dma-buf: the importer maps the pages */
+	if (bo->base.dma_buf || bo->base.import_attach)
+		return -EBUSY;
+	if (!amdgpu_ttm_bo_eviction_valuable(bo, &place))
+		return -EBUSY;
+
+	*scanned += ttm->num_pages;
+
+	/* freed pages must not keep the device mapping (set in amdgpu_ttm_tt_populate) */
+	for (i = 0; i < ttm->num_pages; ++i)
+		if (ttm->pages[i])
+			ttm->pages[i]->mapping = NULL;
+
+	lret = ttm_bo_shrink(ctx, bo, (struct ttm_bo_shrink_flags)
+			     { .purge = purge, .writeback = writeback, .allow_move = true });
+
+	if (lret > 0) {
+		/* the tt is no longer populated: its pages left the shrinkable count */
+		if (gtt->orbis_accounted) {
+			amdgpu_orbis_shrinker_account(adev, gtt->orbis_purgeable, -(long)ttm->num_pages);
+			gtt->orbis_accounted = false;
+		}
+		if (purge) {
+			gtt->orbis_purged = true;
+		} else {
+			gtt->orbis_backed_pages += lret;
+		}
+		amdgpu_orbis_shrinker_shrunk(adev, purge, lret);
+	} else if (ttm_tt_is_populated(ttm)) {
+		/* nothing was taken: put the device mapping back */
+		for (i = 0; i < ttm->num_pages; ++i)
+			if (ttm->pages[i])
+				ttm->pages[i]->mapping = bo->bdev->dev_mapping;
+	}
+
+	return lret;
+}
+
 /**
  * amdgpu_ttm_tt_get_userptr - Return the userptr GTT ttm_tt for the current
  * task
@@ -1254,10 +1390,20 @@ int amdgpu_ttm_tt_set_userptr(struct ttm_buffer_object *bo,
 			return -ENOMEM;
 	}
 
+	gtt = ttm_to_amdgpu_ttm_tt(bo->ttm);
+	/*
+	 * ge-0014: userptr pages are ordinary process memory, reclaimed by the core VM through
+	 * HMM; they are never backed up by the Orbis shrinker. The unused shmem backup file is
+	 * released by ttm_tt_fini().
+	 */
+	if (gtt->orbis_backup) {
+		WARN_ON(gtt->orbis_accounted);
+		bo->ttm->page_flags &= ~TTM_TT_FLAG_EXTERNAL_MAPPABLE;
+		gtt->orbis_backup = false;
+	}
+
 	/* Set TTM_TT_FLAG_EXTERNAL before populate but after create. */
 	bo->ttm->page_flags |= TTM_TT_FLAG_EXTERNAL;
-
-	gtt = ttm_to_amdgpu_ttm_tt(bo->ttm);
 	gtt->userptr = addr;
 	gtt->userflags = flags;
 
@@ -1875,6 +2021,9 @@ int amdgpu_ttm_init(struct amdgpu_device *adev)
 	}
 	adev->mman.initialized = true;
 
+	/* NickLabs Orbis ge-0014: before any buffer exists (eligibility is decided at tt creation) */
+	amdgpu_orbis_shrinker_init(adev);
+
 	/* Initialize VRAM pool with all of VRAM divided into pages */
 	r = amdgpu_vram_mgr_init(adev);
 	if (r) {
@@ -2050,6 +2199,7 @@ void amdgpu_ttm_fini(struct amdgpu_device *adev)
 	if (!adev->mman.initialized)
 		return;
 
+	amdgpu_orbis_shrinker_fini(adev);
 	amdgpu_ttm_pools_fini(adev);
 
 	amdgpu_ttm_training_reserve_vram_fini(adev);
