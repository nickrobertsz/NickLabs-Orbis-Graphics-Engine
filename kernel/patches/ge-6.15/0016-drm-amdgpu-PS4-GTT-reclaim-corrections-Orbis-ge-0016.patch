 #define AMDGPU_PL_GWS		(TTM_PL_PRIV + 1)
@@ -44,10 +45,27 @@ extern const struct attribute_group amdgpu_gtt_mgr_attr_group;
 
 struct hmm_range;
 
+/* ge-0016: state of the PS4 "gtt" dmem cgroup region (reported by orbis_gtt_cgroup) */
+enum amdgpu_orbis_gtt_cg_state {
+	AMDGPU_ORBIS_GTT_CG_NOT_PS4 = 0,	/* not a Liverpool/Gladius device */
+	AMDGPU_ORBIS_GTT_CG_DISABLED,		/* amdgpu.orbis_gtt_cgroup=0 */
+	AMDGPU_ORBIS_GTT_CG_NO_KERNEL_SUPPORT,	/* CONFIG_CGROUP_DMEM not built */
+	AMDGPU_ORBIS_GTT_CG_FAILED,		/* registration returned an error */
+	AMDGPU_ORBIS_GTT_CG_REGISTERED,
+};
+
 struct amdgpu_gtt_mgr {
 	struct ttm_resource_manager manager;
 	struct drm_mm mm;
 	spinlock_t lock;
+	/* NickLabs Orbis (ge-0016) */
+	enum amdgpu_orbis_gtt_cg_state orbis_cg_state;
+	int orbis_cg_error;
+	u64 orbis_cg_capacity;
+	struct mutex orbis_budget_lock;		/* serialises orbis_gtt_budget writes */
+	u64 orbis_requested;			/* last budget written (0 = boot value) */
+	struct amdgpu_orbis_trim_result orbis_last_trim;
+	bool orbis_trim_valid;
 };
 
 struct amdgpu_orbis_shrinker;
diff --git a/drivers/gpu/drm/amd/amdgpu/liverpool_orbis.c b/drivers/gpu/drm/amd/amdgpu/liverpool_orbis.c
index 84b8b8f72..9af7673c9 100644
--- a/drivers/gpu/drm/amd/amdgpu/liverpool_orbis.c
