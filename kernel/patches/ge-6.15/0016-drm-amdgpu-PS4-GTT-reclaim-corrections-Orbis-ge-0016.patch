diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_gtt_mgr.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_gtt_mgr.c
index 72913ba62..e0f99f8e9 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_gtt_mgr.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_gtt_mgr.c
@@ -298,16 +298,33 @@ int amdgpu_gtt_mgr_init(struct amdgpu_device *adev, uint64_t gtt_size)
 	man->use_tt = true;
 	man->func = &amdgpu_gtt_mgr_func;
 
-	/* ge-0015: capacity = the TTM page limit, the most the runtime GTT budget can reach */
-	if (amdgpu_orbis_gtt_cgroup &&
-	    (adev->asic_type == CHIP_LIVERPOOL || adev->asic_type == CHIP_GLADIUS)) {
+	/* ge-0015: capacity = the TTM page limit, the most the runtime GTT budget can reach.
+	 * ge-0016: the outcome is recorded and reported (orbis_gtt_cgroup sysfs) so userspace that
+	 * requires per-app GTT enforcement can refuse instead of running without it. A failed
+	 * registration does not fail the driver: GTT then works exactly as upstream (no region).
+	 */
+	mutex_init(&mgr->orbis_budget_lock);
+	mgr->orbis_cg_state = AMDGPU_ORBIS_GTT_CG_NOT_PS4;
+	if (adev->asic_type == CHIP_LIVERPOOL || adev->asic_type == CHIP_GLADIUS) {
 		u64 cap = max_t(u64, gtt_size, (u64)ttm_tt_pages_limit() << PAGE_SHIFT);
 
-		man->cg = drmm_cgroup_register_region(adev_to_drm(adev), "gtt", cap);
-		if (IS_ERR(man->cg)) {
-			dev_warn(adev->dev, "Orbis: GTT dmem region not registered (%ld)\n",
-				 PTR_ERR(man->cg));
-			man->cg = NULL;
+		mgr->orbis_cg_capacity = cap;
+		if (!amdgpu_orbis_gtt_cgroup) {
+			mgr->orbis_cg_state = AMDGPU_ORBIS_GTT_CG_DISABLED;
+		} else {
+			man->cg = drmm_cgroup_register_region(adev_to_drm(adev), "gtt", cap);
+			if (IS_ERR(man->cg)) {
+				mgr->orbis_cg_error = PTR_ERR(man->cg);
+				mgr->orbis_cg_state = AMDGPU_ORBIS_GTT_CG_FAILED;
+				dev_warn(adev->dev, "Orbis: GTT dmem region not registered (%d); per-app GTT limits unavailable\n",
+					 mgr->orbis_cg_error);
+				man->cg = NULL;
+			} else if (!man->cg) {
+				/* the !CONFIG_CGROUP_DMEM stub returns NULL */
+				mgr->orbis_cg_state = AMDGPU_ORBIS_GTT_CG_NO_KERNEL_SUPPORT;
+			} else {
+				mgr->orbis_cg_state = AMDGPU_ORBIS_GTT_CG_REGISTERED;
+			}
 		}
 	}
 
@@ -338,6 +355,7 @@ void amdgpu_gtt_mgr_fini(struct amdgpu_device *adev)
 	int ret;
 
 	ttm_resource_manager_set_used(man, false);
+	mutex_destroy(&mgr->orbis_budget_lock);
 
 	ret = ttm_resource_manager_evict_all(&adev->mman.bdev, man);
 	if (ret)
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.c
index 3f3630a8c..98ae7300b 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.c
@@ -1277,6 +1277,33 @@ static void amdgpu_ttm_tt_unpopulate(struct ttm_device *bdev,
 static bool amdgpu_ttm_bo_eviction_valuable(struct ttm_buffer_object *bo,
 					    const struct ttm_place *place);
 
+/**
+ * amdgpu_ttm_orbis_evict_to_system - NickLabs Orbis: move one reserved buffer out of GTT
+ * @bo: buffer object, reserved by the caller
+ * @ctx: operation context (no_wait_gpu decides whether busy buffers are skipped)
+ *
+ * ttm_bo_validate() to SYSTEM is a non-eviction move, which leaves per-VM (always valid)
+ * buffers on the VM's "moved" list: the next submission would only update page tables and
+ * the GPU would reach an unpopulated buffer. Mark the move as an eviction afterwards, exactly
+ * as TTM's own eviction path does, so the next submission revalidates (and repopulates) it.
+ * The TT->SYSTEM move itself waits for the buffer's fences (amdgpu_bo_move).
+ */
+int amdgpu_ttm_orbis_evict_to_system(struct ttm_buffer_object *bo, struct ttm_operation_ctx *ctx)
+{
+	static const struct ttm_place sys_place = { .mem_type = TTM_PL_SYSTEM };
+	static struct ttm_placement sys_placement = { .num_placement = 1, .placement = &sys_place };
+	int r;
+
+	dma_resv_assert_held(bo->base.resv);
+	if (bo->resource->mem_type == TTM_PL_SYSTEM)
+		return 0;
+	r = ttm_bo_validate(bo, &sys_placement, ctx);
+	if (r)
+		return r;
+	amdgpu_vm_bo_invalidate(ttm_to_amdgpu_bo(bo), true);
+	return 0;
+}
+
 /**
  * amdgpu_ttm_orbis_shrink_bo - NickLabs Orbis ge-0014: back up or purge one buffer
  * @ctx: operation context of the shrinker walk
@@ -1285,10 +1312,12 @@ static bool amdgpu_ttm_bo_eviction_valuable(struct ttm_buffer_object *bo,
  * @writeback: ask for immediate writeout of the backup to swap
  * @scanned: incremented by the pages examined
  *
- * Moves the buffer to SYSTEM through ttm_bo_shrink() (the regular TT->SYSTEM move: VM
- * invalidation via move_notify, GART unbind) and backs its pages up into shmem, or purges
- * them. Imported or exported dma-bufs, userptr buffers, kernel buffers and TTM ghost objects
- * are never touched. Returns pages backed up/purged, or a negative error (-EBUSY: skip).
+ * Moves the buffer to SYSTEM as an eviction (amdgpu_ttm_orbis_evict_to_system: waits for
+ * fences, GART unbind, VM revalidation on next use), then ttm_bo_shrink() backs its pages up
+ * into shmem, or purges them. Requires the CVE-2026-52949 TTM fix (series stable-6.15/0002):
+ * without it a failed backup could make the LRU walk loop forever. Imported or exported
+ * dma-bufs, userptr buffers, kernel buffers and TTM ghost objects are never touched.
+ * Returns pages backed up/purged, or a negative error (-EBUSY: skip).
  */
 long amdgpu_ttm_orbis_shrink_bo(struct ttm_operation_ctx *ctx, struct ttm_buffer_object *bo,
 				bool purge, bool writeback, unsigned long *scanned)
@@ -1314,6 +1343,14 @@ long amdgpu_ttm_orbis_shrink_bo(struct ttm_operation_ctx *ctx, struct ttm_buffer
 	if (!amdgpu_ttm_bo_eviction_valuable(bo, &place))
 		return -EBUSY;
 
+	/* out of GTT first, as an eviction (see amdgpu_ttm_orbis_evict_to_system) */
+	if (bo->resource->mem_type != TTM_PL_SYSTEM) {
+		int r = amdgpu_ttm_orbis_evict_to_system(bo, ctx);
+
+		if (r)
+			return (r == -ENOMEM || r == -ENOSPC) ? -EBUSY : r;
+	}
+
 	*scanned += ttm->num_pages;
 
 	/* freed pages must not keep the device mapping (set in amdgpu_ttm_tt_populate) */
@@ -1322,7 +1359,7 @@ long amdgpu_ttm_orbis_shrink_bo(struct ttm_operation_ctx *ctx, struct ttm_buffer
 			ttm->pages[i]->mapping = NULL;
 
 	lret = ttm_bo_shrink(ctx, bo, (struct ttm_bo_shrink_flags)
-			     { .purge = purge, .writeback = writeback, .allow_move = true });
+			     { .purge = purge, .writeback = writeback, .allow_move = false });
 
 	if (lret > 0) {
 		/* the tt is no longer populated: its pages left the shrinkable count */
