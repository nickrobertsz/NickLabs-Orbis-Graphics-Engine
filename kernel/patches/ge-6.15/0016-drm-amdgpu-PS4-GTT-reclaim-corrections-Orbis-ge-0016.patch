@@ -85,23 +90,69 @@ static ssize_t orbis_engine_busy_show(struct device *dev, struct device_attribut
 }
 static DEVICE_ATTR_RO(orbis_engine_busy);
 
+static const char *orbis_trim_state(const struct amdgpu_gtt_mgr *mgr, u64 usage, u64 budget)
+{
+	if (usage <= budget)
+		return "enforced";
+	if (!mgr->orbis_trim_valid)
+		return "over_budget";	/* never trimmed: boot value, or usage grew after a raise */
+	if (mgr->orbis_last_trim.error)
+		return "interrupted";
+	return "incomplete";
+}
+
 static ssize_t orbis_gtt_budget_show(struct device *dev, struct device_attribute *attr, char *buf)
 {
 	struct amdgpu_device *adev = drm_to_adev(dev_get_drvdata(dev));
-	struct ttm_resource_manager *man = ttm_manager_type(&adev->mman.bdev, TTM_PL_TT);
+	struct amdgpu_gtt_mgr *mgr = &adev->mman.gtt_mgr;
+	struct ttm_resource_manager *man = &mgr->manager;
+	const struct amdgpu_orbis_trim_result *t = &mgr->orbis_last_trim;
+	u64 budget, usage;
+	ssize_t n;
 
-	return sysfs_emit(buf, "budget=%llu usage=%llu ttm_pages_limit=%llu min=%llu vram_carveout=%llu\n",
-			  READ_ONCE(man->size), ttm_resource_manager_usage(man),
-			  (u64)ttm_tt_pages_limit() << PAGE_SHIFT, ORBIS_GTT_MIN_BYTES,
-			  adev->gmc.real_vram_size);
+	/* a trim in progress holds the lock; a reader can interrupt the wait */
+	n = mutex_lock_interruptible(&mgr->orbis_budget_lock);
+	if (n)
+		return n;
+	budget = READ_ONCE(man->size);
+	usage = ttm_resource_manager_usage(man);
+	/*
+	 * budget    = effective limit amdgpu applies to new GTT allocations
+	 * requested = the last value written (equal to budget once accepted; 0 = boot default)
+	 * state     = enforced | over_budget | incomplete | interrupted (usage vs budget, see trim)
+	 * last_trim = account of the most recent active trim, so partial progress stays visible
+	 */
+	n = sysfs_emit(buf, "budget=%llu requested=%llu usage=%llu state=%s ttm_pages_limit=%llu min=%llu vram_carveout=%llu\n",
+		       budget, mgr->orbis_requested, usage, orbis_trim_state(mgr, usage, budget),
+		       (u64)ttm_tt_pages_limit() << PAGE_SHIFT, ORBIS_GTT_MIN_BYTES,
+		       adev->gmc.real_vram_size);
+	if (mgr->orbis_trim_valid)
+		n += sysfs_emit_at(buf, n, "last_trim requested=%llu usage_before=%llu usage_after=%llu evicted=%u failed=%u skipped=%u first_failure=%d error=%d limit_hit=%d enforced=%d\n",
+				   t->requested, t->usage_before, t->usage_after, t->evicted,
+				   t->failed, t->skipped, t->first_failure, t->error,
+				   t->limit_hit, t->enforced);
+	mutex_unlock(&mgr->orbis_budget_lock);
+	return n;
 }
 
+/*
+ * Write a byte value. The new budget applies to later allocations at once and stays applied
+ * whatever happens next. If usage is above it, an active trim runs; the write then returns:
+ *   count        usage now fits (or no trim was needed)
+ *   -EBUSY       the budget is set but usage is still above it (pinned, busy or unmovable
+ *                buffers, or the per-call cap); see "state" and "last_trim" in the file
+ *   -EINTR/-ERESTARTSYS  interrupted by a signal; the budget is set, the trim is partial
+ *   -ERANGE / -EINVAL     rejected, nothing changed
+ * A writer can retry the same value to continue a partial trim.
+ */
 static ssize_t orbis_gtt_budget_store(struct device *dev, struct device_attribute *attr,
 				      const char *buf, size_t count)
 {
 	struct amdgpu_device *adev = drm_to_adev(dev_get_drvdata(dev));
-	struct ttm_resource_manager *man = ttm_manager_type(&adev->mman.bdev, TTM_PL_TT);
-	u64 val, limit = (u64)ttm_tt_pages_limit() << PAGE_SHIFT, old;
+	struct amdgpu_gtt_mgr *mgr = &adev->mman.gtt_mgr;
+	struct ttm_resource_manager *man = &mgr->manager;
+	u64 val, limit = (u64)ttm_tt_pages_limit() << PAGE_SHIFT, old, usage;
+	struct amdgpu_orbis_trim_result res;
 	int r;
 
 	r = kstrtou64(buf, 0, &val);
@@ -110,26 +161,36 @@ static ssize_t orbis_gtt_budget_store(struct device *dev, struct device_attribut
 	if (val < ORBIS_GTT_MIN_BYTES || val > limit)
 		return -ERANGE;
 	val = round_down(val, PAGE_SIZE);
+
+	r = mutex_lock_interruptible(&mgr->orbis_budget_lock);
+	if (r)
+		return r;
 	old = READ_ONCE(man->size);
 	/* ttm_resource_manager.size is documented as constant; amdgpu only uses it as the
 	 * budget compared against usage in amdgpu_gtt_mgr_new() and for reporting, so a
 	 * new value applies to later allocations only. */
 	WRITE_ONCE(man->size, val);
+	mgr->orbis_requested = val;
+	usage = ttm_resource_manager_usage(man);
 	dev_info(adev->dev, "Orbis: GTT budget %llu MiB -> %llu MiB (usage %llu MiB)\n",
-		 old >> 20, val >> 20, ttm_resource_manager_usage(man) >> 20);
-
-	/* ge-0014 active trim: do not wait for the next allocation to enforce a lower budget */
-	if (ttm_resource_manager_usage(man) > val) {
-		unsigned int evicted = 0;
-		long tr = amdgpu_orbis_gtt_trim(adev, val, &evicted);
-
-		dev_info(adev->dev, "Orbis: GTT trim evicted %u buffers, usage now %llu MiB%s\n",
-			 evicted, ttm_resource_manager_usage(man) >> 20,
-			 tr ? " (stopped early)" : "");
-		if (tr == -ERESTARTSYS || tr == -EINTR)
-			return tr;
+		 old >> 20, val >> 20, usage >> 20);
+
+	r = 0;
+	if (usage > val) {
+		/* ge-0014/0016 active trim: do not wait for the next allocation */
+		r = amdgpu_orbis_gtt_trim(adev, val, &res);
+		mgr->orbis_last_trim = res;
+		mgr->orbis_trim_valid = true;
+		if (r)
+			dev_warn(adev->dev, "Orbis: GTT trim to %llu MiB incomplete (%d): usage %llu MiB, evicted %u, failed %u (first %d)%s\n",
+				 val >> 20, r, res.usage_after >> 20, res.evicted, res.failed,
+				 res.first_failure, res.limit_hit ? ", eviction cap reached" : "");
+		else
+			dev_info(adev->dev, "Orbis: GTT trim evicted %u buffers, usage now %llu MiB\n",
+				 res.evicted, res.usage_after >> 20);
 	}
-	return count;
+	mutex_unlock(&mgr->orbis_budget_lock);
+	return r ? r : count;
 }
 static DEVICE_ATTR_RW(orbis_gtt_budget);
 
@@ -156,10 +217,31 @@ static ssize_t orbis_gtt_reclaim_store(struct device *dev, struct device_attribu
 }
 static DEVICE_ATTR_RW(orbis_gtt_reclaim);
 
+/* ge-0016: whether the "gtt" dmem cgroup region exists, and why not */
+static ssize_t orbis_gtt_cgroup_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct amdgpu_gtt_mgr *mgr = &drm_to_adev(dev_get_drvdata(dev))->mman.gtt_mgr;
+
+	switch (mgr->orbis_cg_state) {
+	case AMDGPU_ORBIS_GTT_CG_REGISTERED:
+		return sysfs_emit(buf, "registered region=gtt capacity=%llu\n", mgr->orbis_cg_capacity);
+	case AMDGPU_ORBIS_GTT_CG_DISABLED:
+		return sysfs_emit(buf, "unavailable reason=param_off\n");
+	case AMDGPU_ORBIS_GTT_CG_NO_KERNEL_SUPPORT:
+		return sysfs_emit(buf, "unavailable reason=no_cgroup_dmem\n");
+	case AMDGPU_ORBIS_GTT_CG_FAILED:
+		return sysfs_emit(buf, "unavailable reason=register_failed error=%d\n", mgr->orbis_cg_error);
+	default:
+		return sysfs_emit(buf, "unavailable reason=not_ps4\n");
+	}
+}
+static DEVICE_ATTR_RO(orbis_gtt_cgroup);
+
 static struct attribute *liverpool_orbis_attrs[] = {
 	&dev_attr_orbis_engine_busy.attr,
 	&dev_attr_orbis_gtt_budget.attr,
 	&dev_attr_orbis_gtt_reclaim.attr,
+	&dev_attr_orbis_gtt_cgroup.attr,
 	NULL,
 };
 
