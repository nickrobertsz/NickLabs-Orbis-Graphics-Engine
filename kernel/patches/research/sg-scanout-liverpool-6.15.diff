@@ -1841,14 +1841,21 @@ static int dce_v8_0_crtc_do_set_base(struct drm_crtc *crtc,
 		return r;
 
 	if (!atomic) {
-		abo->flags |= AMDGPU_GEM_CREATE_VRAM_CONTIGUOUS;
-		r = amdgpu_bo_pin(abo, AMDGPU_GEM_DOMAIN_VRAM);
+		/* Orbis research R-M1: same domain choice as page flips (GTT when enabled) */
+		u32 domain = amdgpu_display_supported_domains(adev, abo->flags);
+
+		if (domain & AMDGPU_GEM_DOMAIN_VRAM)
+			abo->flags |= AMDGPU_GEM_CREATE_VRAM_CONTIGUOUS;
+		r = amdgpu_bo_pin(abo, domain);
 		if (unlikely(r != 0)) {
 			amdgpu_bo_unreserve(abo);
 			return -EINVAL;
 		}
 	}
 	fb_location = amdgpu_bo_gpu_offset(abo);
+	if (abo->tbo.resource->mem_type == TTM_PL_TT)
+		dev_info_once(adev->dev, "Orbis research: primary plane scanned out from GTT at 0x%llx\n",
+			      (unsigned long long)fb_location);
 
 	amdgpu_bo_get_tiling_flags(abo, &tiling_flags);
 	amdgpu_bo_unreserve(abo);
