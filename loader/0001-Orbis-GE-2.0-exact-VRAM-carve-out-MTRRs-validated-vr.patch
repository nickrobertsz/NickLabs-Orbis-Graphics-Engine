+    {
+        struct orbis_vram_block blk[ORBIS_VRAM_MAX_BLOCKS];
+        int n = orbis_vram_split(vram_base, (unsigned long long)vram_mb * vram_size,
+                                 blk, ORBIS_VRAM_MAX_BLOCKS);
+        int vcnt = (int)(rdmsr(0xfe) & 0xff);   /* IA32_MTRRCAP.VCNT */
+        int i;
+
+        if (n < 0 || ORBIS_VRAM_FIRST_MTRR + n > vcnt) {
+            /* cannot happen for sizes accepted by orbis_vram_valid(); keep upstream behaviour */
+            wrmsr(MTRR_BASE(3), 0x0100000000);
+            wrmsr(MTRR_MASK(3), (0xffffffffff - vram_mb * vram_size + 1) | 0x800);
+        } else {
+            for (i = 0; i < n; i++) {
+                wrmsr(MTRR_BASE(ORBIS_VRAM_FIRST_MTRR + i), blk[i].base);   /* type 0 = UC */
+                wrmsr(MTRR_MASK(ORBIS_VRAM_FIRST_MTRR + i), orbis_mtrr_mask(blk[i].size));
+            }
+            for (i = ORBIS_VRAM_FIRST_MTRR + n; i < vcnt && i < 8; i++) {
+                wrmsr(MTRR_BASE(i), 0);
+                wrmsr(MTRR_MASK(i), 0);
+            }
+        }
+    }
 
