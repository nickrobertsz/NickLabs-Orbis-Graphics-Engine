index 0000000..450674a
--- /dev/null
+++ b/linux/ps4-kexec-common/orbis_vram.h
@@ -0,0 +1,78 @@
+/*
+ * orbis_vram.h - NickLabs Orbis Graphics Engine 2.0: VRAM carve-out geometry for the PS4
+ * loader (MIT, NickLabs contributors).
+ *
+ * The loader reserves vram_mb at physical 4 GiB (E820), programs MC_VM_FB_LOCATION
+ * (16 MiB granularity) and CONFIG_MEMSIZE, and marks the range uncacheable with MTRRs.
+ * Upstream uses ONE variable MTRR with mask = ~(size - 1), which is only a valid MTRR
+ * for power-of-two sizes: 3072 MiB (offered by the upstream Makefile) or 768 MiB give a
+ * non-contiguous mask and an undefined cache type over part of the carve-out and of
+ * Linux RAM. orbis_vram_split() covers [base, base + size) exactly with power-of-two,
+ * naturally aligned blocks (largest first), one variable MTRR each.
+ *
+ * Header-only and freestanding so that it is unit-tested on the build host.
+ */
+#ifndef ORBIS_VRAM_H
+#define ORBIS_VRAM_H
+
+#define ORBIS_VRAM_GRANULE_MB	16	/* MC_VM_FB_LOCATION granularity */
+#define ORBIS_VRAM_MIN_MB	64
+#define ORBIS_VRAM_MAX_MB	4096
+#define ORBIS_VRAM_FIRST_MTRR	3	/* 0..2 are the WB RAM ranges */
+#define ORBIS_VRAM_MAX_BLOCKS	5	/* variable MTRRs 3..7 */
+
+struct orbis_vram_block {
+	unsigned long long base;
+	unsigned long long size;
+};
+
+/* 1 if vram_mb is a carve-out size the loader can program exactly, else 0 */
+static inline int orbis_vram_valid(int vram_mb)
+{
+	int blocks = 0;
+	unsigned int v;
+
+	if (vram_mb < ORBIS_VRAM_MIN_MB || vram_mb > ORBIS_VRAM_MAX_MB)
+		return 0;
+	if (vram_mb % ORBIS_VRAM_GRANULE_MB)
+		return 0;
+	for (v = (unsigned int)vram_mb; v; v &= v - 1)
+		blocks++;
+	return blocks <= ORBIS_VRAM_MAX_BLOCKS;
+}
+
+/*
+ * Split [base, base + size) into power-of-two blocks, largest first. base must be
+ * aligned to the largest block (the carve-out starts at 4 GiB). Returns the number of
+ * blocks written, or -1 if more than max are needed.
+ */
+static inline int orbis_vram_split(unsigned long long base, unsigned long long size,
+				   struct orbis_vram_block *out, int max)
+{
+	int n = 0;
+	int bit;
+
+	for (bit = 63; bit >= 0; bit--) {
+		unsigned long long blk = 1ULL << bit;
+
+		if (!(size & blk))
+			continue;
+		if (n == max)
+			return -1;
+		if (base & (blk - 1))
+			return -1;	/* not naturally aligned */
+		out[n].base = base;
+		out[n].size = blk;
+		base += blk;
+		n++;
+	}
+	return n;
+}
+
+/* MTRR PHYSMASK value for a power-of-two block on a 40-bit physical address machine */
+static inline unsigned long long orbis_mtrr_mask(unsigned long long size)
+{
+	return ((0xffffffffffULL - size + 1) & 0xfffffff000ULL) | 0x800ULL;
+}
+
+#endif
