+/* NickLabs Orbis: append " <token>" to dst (bounded); returns 0 or -1 */
+static int orbis_append(char *dst, unsigned long long cap, unsigned long long *len, const char *tok)
+{
+    unsigned long long i;
+
+    if (*len + 1 >= cap)
+        return -1;
+    dst[(*len)++] = ' ';
+    for (i = 0; tok[i]; i++) {
+        if (*len + 1 >= cap)
+            return -1;
+        dst[(*len)++] = tok[i];
+    }
+    dst[*len] = '\0';
+    return 0;
+}
+
+static int orbis_append_num(char *dst, unsigned long long cap, unsigned long long *len,
+                            const char *key, long long val)
+{
+    char buf[64];
+    int n = 0, k = 0;
+    char digits[24];
+
+    while (key[k] && n < 40)
+        buf[n++] = key[k++];
+    if (val < 0) {
+        buf[n++] = '-';
+        val = -val;
+    }
+    k = 0;
+    do {
+        digits[k++] = (char)('0' + val % 10);
+        val /= 10;
+    } while (val && k < 20);
+    while (k)
+        buf[n++] = digits[--k];
+    buf[n] = '\0';
+    return orbis_append(dst, cap, len, buf);
+}
+
+/*
+ * cmdline + " orbis.loader=ge2 orbis.vram_mb=N [orbis.gtt_mb=N ttm.pages_limit=P amdgpu.gttsize=N]"
+ * into dst. The kernel ignores unknown orbis.* parameters; orbis-blackbox reads them from
+ * /proc/cmdline to record the boot memory contract.
+ */
+static int orbis_cmdline_compose(char *dst, unsigned long long cap, const char *src,
+                                 int vram_mb, int gtt_mb)
+{
+    unsigned long long len = 0;
+
+    while (src && src[len] && len + 1 < cap) {
+        dst[len] = src[len];
+        len++;
+    }
+    dst[len] = '\0';
+    if (src && src[len])
+        return -1;
+    if (orbis_append(dst, cap, &len, "orbis.loader=ge2") ||
+        orbis_append_num(dst, cap, &len, "orbis.vram_mb=", vram_mb))
+        return -1;
+    if (gtt_mb > 0) {
+        if (orbis_append_num(dst, cap, &len, "orbis.gtt_mb=", gtt_mb) ||
+            orbis_append_num(dst, cap, &len, "ttm.pages_limit=", (long long)gtt_mb * 256) ||
+            orbis_append_num(dst, cap, &len, "amdgpu.gttsize=", gtt_mb))
+            return -1;
+    }
+    return 0;
+}
