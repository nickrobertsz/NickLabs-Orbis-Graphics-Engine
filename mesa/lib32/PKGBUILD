# NickLabs Orbis Graphics Engine 2.0 — 32-bit Mesa for Steam/Proton/Wine, built from the SAME pinned source
# and patch series as mesa-orbis-ps4 (versions must match; `orbis doctor` checks it).
pkgname=lib32-mesa-orbis-ps4
_mesaver=26.2.5
pkgver=${_mesaver}
pkgrel=201
pkgdesc="32-bit Mesa radeonsi + RADV with NickLabs Orbis PS4 patches"
arch=('x86_64')
url="https://www.mesa3d.org"
license=('MIT' 'custom')
depends=("mesa-orbis-ps4=${pkgver}-${pkgrel}" 'lib32-libdrm' 'lib32-libxshmfence' 'lib32-libelf' 'lib32-libglvnd'
         'lib32-wayland' 'lib32-zstd' 'lib32-expat' 'lib32-llvm-libs' 'lib32-libx11' 'lib32-libxext'
         'lib32-libxfixes' 'lib32-libxxf86vm' 'lib32-libxcb' 'lib32-vulkan-icd-loader' 'lib32-lm_sensors'
         'lib32-systemd' 'lib32-spirv-tools')
makedepends=('meson' 'ninja' 'python-mako' 'python-packaging' 'python-yaml' 'glslang' 'lib32-llvm'
             'xorgproto' 'wayland-protocols' 'byacc' 'flex')
provides=("lib32-mesa=${_mesaver}" 'lib32-opengl-driver' 'lib32-vulkan-driver' 'lib32-vulkan-radeon')
conflicts=('lib32-mesa' 'lib32-vulkan-radeon' 'lib32-mesa-ps4' 'lib32-vulkan-swrast')
replaces=('lib32-mesa-ps4')
options=('!lto' '!debug')
source=("https://archive.mesa3d.org/mesa-${_mesaver}.tar.xz"
        "0001-ps4-graphics-families.patch"
        "0002-ps4-uvd-avc-capabilities.patch"
        "0003-addrlib-selected-fmask-entry.patch"
        "0005-radv-bound-meta-fill-offset.patch"
        "LICENSE.ps4-mesa")
sha256sums=('794b3d1729075dae7ebd47c7283b7ca0cdb5dec668f7f11cc0a5d82f6138a0a5'
            'b3cf0f24fd00f156bbba12be0c270189ad30c274646b5e86298890e4cb4829cc'
            'ea9d72c9335872b1cf41611ba225e4b645b5ecd81feff8323f4302e038196ac0'
            '10f6369f300bd884290cc812254ee3f66694b3d0fdaeee37451b1f93561ba07c'
            '92256289369f880d6c8a85c7bec8341c29da6b7d13706bc4120795e99788ae25'
            '7fdc119cf53c8ca65396ea73f6d10af641ba41ea1dd2bd44a824726e01c8b3f2')

prepare() {
  cd "mesa-${_mesaver}"
  for p in 0001-ps4-graphics-families.patch 0002-ps4-uvd-avc-capabilities.patch 0003-addrlib-selected-fmask-entry.patch \
           0005-radv-bound-meta-fill-offset.patch; do
    patch -Np1 -F0 -i "$srcdir/$p"
  done
  cat > "$srcdir/crossfile.ini" <<'CF'
[binaries]
llvm-config = '/usr/bin/llvm-config32'
CF
}

build() {
  export CC="gcc -m32" CXX="g++ -m32" PKG_CONFIG=i686-pc-linux-gnu-pkg-config
  export CFLAGS="${CFLAGS/-march=x86-64-v[234]/-march=x86-64} -mtune=btver2"
  export CXXFLAGS="${CXXFLAGS/-march=x86-64-v[234]/-march=x86-64} -mtune=btver2"
  arch-meson "mesa-${_mesaver}" build --native-file "$srcdir/crossfile.ini" --libdir=/usr/lib32 \
    -D b_ndebug=true -D platforms=x11,wayland -D gallium-drivers=radeonsi,llvmpipe \
    -D vulkan-drivers=amd -D vulkan-layers= -D video-codecs= -D gallium-va=disabled \
    -D gallium-rusticl=false -D llvm=enabled -D shared-llvm=enabled \
    -D glx=dri -D egl=enabled -D gbm=enabled -D gles1=disabled -D gles2=enabled -D glvnd=enabled \
    -D valgrind=disabled -D intel-rt=disabled
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  rm -rf "$pkgdir"/usr/{include,share,bin}
  install -Dm644 "LICENSE.ps4-mesa" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.ps4-mesa"
}
