#!/usr/bin/env bash
# NickLabs Orbis Graphics Engine 2.0.0 — the one command for Nobara.
#
#   ./orbis-ge all --orbis-src ~/orbis-release/nicklabs-ps4-orbis-linux \
#                  --target cuh-1215a --base-image ~/orbis-release/orbis-0.2.0-cuh1215a.img \
#                  [--base-stage0-image ~/orbis-release/orbis-0.2.0-stage0.img] [--jobs N]
#                  [--bore] [--research-uvd] [--research-sgdisplay]
#
#   several targets:  --target cuh-1215a,cuh-12xx --base-image cuh-1215a=A.img --base-image cuh-12xx=B.img
#   (without --target the registry's reference target is used, and the run says so)
#
#   ./orbis-ge check | kernel | loader | pack | image | stage0 | verify | status   (single steps, same options)
#   ./orbis-ge target list | inspect <id> | generate | check      the board-support registry (targets/)
#   ./orbis-ge port probe <probe.json> | new <id> --probe <probe.json> | review ... | report <id>   (PortForge)
#   ./orbis-ge runners [--only GE-Proton10-34,dxvk-2.7.1]   download + verify the pinned Proton/DXVK/VKD3D
#              runners into out/runners/ (offline bundle; several GB; not part of 'all')
#
# Steps (each is skipped only when its output exists AND its input fingerprint is unchanged:
# sources, patches, configs, locks, toolchain container and options; --rebuild forces it):
#   0 check    host tests (Python always; Rust when cargo is installed)    -> out/logs/check.log
#   1 kernel   kernel/build-ge-kernel.sh   -> out/kernel-ge/        (one per kernel flavor; shared by targets)
#   2 loader   loader/build-loader.sh      -> out/loader-ge/        (GE loader payloads, 1 min)
#   3 pack     build/build-pack.sh         -> out/release/ORBIS-GRAPHICS-ENGINE-v2.0.0.tar.zst (Mesa and userspace shared)
#   4 image    orbis-graphics integrate    -> out/targets/<id>/images/orbis-0.2.0+ge-2.0.0-<id>.img (COPY of the base)
#   5 stage0   orbis-graphics stage0       -> out/targets/<id>/images/orbis-0.2.0-stage0+ge-2.0.0-<id>.img
#   6 verify   checksums + build receipt   -> out/targets/<id>/{images/SHA256SUMS,ORBIS-GE-RELEASE-RECEIPT.json},
#                                             out/RELEASE-MANIFEST.json (all targets of the run)
#
# Every output gets <file>.provenance.json (target, source revision, patch-set hash, config hash,
# toolchain, options, fingerprint, sha256). The pack takes only artifacts selected for this run
# (out/artifact-selection.json): an old BORE kernel or stage-0 image never slips in.
# Every step logs to out/logs/<step>.log; a failing step stops the run with its exit code.
# Never modified: the Orbis 0.2.0 checkout (checked before/after), its images (copied first), the
# Graphics Pack 1.0.0 release, the Nobara system outside this folder (sudo only for podman), any PS4.
set -euo pipefail
R="$(cd "$(dirname "$0")" && pwd)"
cd "$R"
cmd="${1:-help}"; [ $# -gt 0 ] && shift
targets_py() { PYTHONPATH="$R/diag${PYTHONPATH:+:$PYTHONPATH}" python3 -m orbis_targets "$@"; }

# registry and PortForge commands take their own options
case "$cmd" in
  target) targets_py target "$@"; exit $? ;;
  port)
    sub="${1:-help}"; [ $# -gt 0 ] && shift
    case "$sub" in
      probe)
        [ $# -ge 1 ] || { echo "usage: ./orbis-ge port probe <probe.json> [--log FILE] [--model CUH-....]" >&2; exit 2; }
        f="$1"; shift
        set +e; targets_py identify --probe "$f" "$@"; rc=$?; set -e
        if [ "$rc" = 0 ]; then targets_py compatibility --probe "$f" "$@"; fi
        exit "$rc" ;;
      new|candidate|diff-trees|assist|check|review|report|promote)
        ORBIS_PORTFORGE_DIR="$R/out/portforge" targets_py port "$sub" "$@"; exit $? ;;
      *) echo "usage: ./orbis-ge port probe|new|candidate|diff-trees|assist|check|review|report|promote ..." >&2; exit 2 ;;
    esac ;;
esac

orbis_src=""; jobs=""; uvd=0; sgd=0; bore=0; rebuild=0; only=""; target_opt=""
declare -A BASE=() BASE0=()
abspath() { realpath -m -- "$1"; }
args=()
add_base() {   # add_base <assoc-name> <value>: "path" (one target) or "id=path"
  local -n m="$1"
  case "$2" in
    *=*) local k="${2%%=*}"; if [[ "$k" =~ ^[a-z0-9-]+$ ]]; then m["$k"]="$(abspath "${2#*=}")"; return; fi ;;
  esac
  m["*"]="$(abspath "$2")"
}
while [ $# -gt 0 ]; do
  case "$1" in
    --orbis-src) orbis_src="$(abspath "$2")"; shift 2 ;;
    --base-image) add_base BASE "$2"; shift 2 ;;
    --base-stage0-image) add_base BASE0 "$2"; shift 2 ;;
    --jobs) jobs="$2"; shift 2 ;;
    --research-uvd) uvd=1; shift ;;
    --research-sgdisplay) sgd=1; shift ;;
    --bore) bore=1; shift ;;
    --rebuild) rebuild=1; shift ;;
    --only) only="$2"; shift 2 ;;
    --target) target_opt="$2"; shift 2 ;;
    --*) echo "unknown option $1" >&2; exit 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
ver="$(python3 -c "import json; print(json.load(open('manifest/release.json'))['version'])")"
pfx="$(python3 -c "import json; print(json.load(open('manifest/release.json'))['archive_prefix'])")"
PACK="out/release/$pfx-v$ver.tar.zst"
mkdir -p out/logs out/.fp
say() { echo; echo "######## $*"; }
need_src() { [ -n "$orbis_src" ] && [ -f "$orbis_src/kernel/build-kernel.sh" ] || {
  echo "--orbis-src <Orbis 0.2.0 checkout> is required for '$cmd'" >&2; exit 2; }; }

# ---------------------------------------------------------------- targets (Porting Kit registry)
TARGETS=()
target_by=explicit
resolve_targets() {
  local list="$target_opt"
  if [ -z "$list" ]; then
    targets_py target check >/dev/null || { echo "!!! targets/ registry invalid or not generated: ./orbis-ge target check" >&2; exit 2; }
    list="$(python3 -c "import json; print(json.load(open('targets/generated/registry.json'))['reference'])")"
    target_by="default (registry reference target)"
  fi
  IFS=',' read -r -a TARGETS <<< "$list"
  local t
  for t in "${TARGETS[@]}"; do
    targets_py target resolve "$t" status >/dev/null || exit 2
  done
  echo "   target(s): ${TARGETS[*]}  [$target_by]"
}
flavor_of() { targets_py target resolve "$1" kernel-flavor; }
require_buildable() {   # a target whose kernel flavor is unsupported has no GE image
  local t="$1"
  if [ "$(targets_py target resolve "$t" buildable)" != yes ]; then
    echo "!!! target $t is unsupported: $(python3 -c "import json,sys; e=json.load(open('targets/generated/registry.json'))['targets'][sys.argv[1]]; print(e['kernel'].get('reason'))" "$t")" >&2
    echo "    PortForge can describe the gaps: ./orbis-ge port new $t-port --probe <probe.json>" >&2
    exit 6
  fi
}
FLAVOR=""
resolve_flavor() {   # every target of one run must share the kernel flavor the pack carries
  local t f
  for t in "${TARGETS[@]}"; do
    require_buildable "$t"
    f="$(flavor_of "$t")"
    if [ -z "$FLAVOR" ]; then FLAVOR="$f"; elif [ "$f" != "$FLAVOR" ]; then
      echo "!!! targets need different kernel flavors ($FLAVOR, $f): build them in separate runs" >&2; exit 2; fi
  done
  if [ "$FLAVOR" != aeolia-belize-6.15 ]; then
    echo "!!! kernel flavor $FLAVOR has no build recipe (only aeolia-belize-6.15 exists)" >&2; exit 6
  fi
}
T=""; TDIR=""; IMG=""; IMG0=""; base=""; base0=""
use_target() {
  T="$1"; TDIR="out/targets/$T"
  IMG="$TDIR/images/orbis-0.2.0+ge-$ver-$T.img"
  IMG0="$TDIR/images/orbis-0.2.0-stage0+ge-$ver-$T.img"
  base="${BASE[$T]:-}"; base0="${BASE0[$T]:-}"
  if [ "${#TARGETS[@]}" = 1 ]; then
    [ -n "$base" ] || base="${BASE["*"]:-}"
    [ -n "$base0" ] || base0="${BASE0["*"]:-}"
  fi
  if [ -n "$base0" ] && [ ! -f "$base0" ]; then
    echo "--base-stage0-image $base0 does not exist (leave the option out to skip the stage-0 image)" >&2; exit 2
  fi
}
check_base_args() {
  if [ "${#TARGETS[@]}" -gt 1 ] && { [ -n "${BASE["*"]:-}" ] || [ -n "${BASE0["*"]:-}" ]; }; then
    echo "several targets: give base images as --base-image <target>=<file>" >&2; exit 2
  fi
  local k
  for k in "${!BASE[@]}" "${!BASE0[@]}"; do
    [ "$k" = "*" ] && continue
    [[ " ${TARGETS[*]} " == *" $k "* ]] || { echo "base image given for $k, which is not a --target of this run" >&2; exit 2; }
  done
}

# ---------------------------------------------------------------- fingerprints
# sha256 over the names and contents of the given files/directories (out/, .git, target/ and
# __pycache__ are skipped). Directories outside this tree (the Orbis 0.2.0 checkout) work too.
fp_files() {
  python3 - "$@" <<'PY'
import hashlib, os, sys
h = hashlib.sha256()
for root in sys.argv[1:]:
    files = []
    if os.path.isfile(root):
        files = [root]
    elif os.path.isdir(root):
        for d, dirs, fs in os.walk(root):
            dirs[:] = sorted(x for x in dirs if x not in (".git", "__pycache__", "target", "out"))
            files += [os.path.join(d, f) for f in fs]
    else:
        h.update(b"missing:" + root.encode())
    for f in sorted(files):
        h.update(f.encode() + b"\0")
        try:
            with open(f, "rb") as fh:
                for c in iter(lambda: fh.read(1 << 20), b""):
                    h.update(c)
        except OSError as e:
            h.update(b"unreadable:" + str(e).encode())
print(h.hexdigest())
PY
}
fp_str() { printf '%s' "$*" | sha256sum | cut -d' ' -f1; }
image_id() { $SUDO "${ENGINE:-podman}" image inspect --format '{{.Id}}' "$1" 2>/dev/null || echo "absent:$1"; }
SUDO=""; [ "$(id -u)" = 0 ] || SUDO="sudo"
fp_of() {   # fp_of <step>  (the fingerprint the step would have now); image/stage0 use the current target
  case "$1" in
    kernel*) fp_str "$(fp_files kernel manifest/sources.json)" "$(fp_files "$orbis_src/kernel")" "$(image_id orbis-build:0.2.0)" \
                    "variant=$1" "flavor=${FLAVOR:-aeolia-belize-6.15}" "rust=${RUST_KERNEL_TOOLCHAIN:-1.87.0}" "jobs-independent" ;;
    loader) fp_str "$(fp_files loader manifest/sources.json)" "$(image_id orbis-build:0.2.0)" ;;
    pack) fp_str "$(fp_files . )" "$(cat out/.fp/kernel 2>/dev/null)" "$(cat out/.fp/kernel-bore 2>/dev/null)" \
                 "$(cat out/.fp/loader 2>/dev/null)" "$(fp_files "$orbis_src/platform" "$orbis_src/out/repo/orbis.db.tar.zst")" \
                 "$(image_id orbis-build:0.2.0)" "$(image_id "orbis-gfx-build:$ver")" "bore=$bore" "flavor=${FLAVOR:-aeolia-belize-6.15}" ;;
    image@*) fp_str "$(cat "$PACK.sha256" 2>/dev/null)" "$(stat -c '%s %Y %i' "$base" 2>/dev/null)" "$(fp_files integrator orbis-graphics)" "target=$T" ;;
    stage0@*) fp_str "$(cat "$PACK.sha256" 2>/dev/null)" "$(stat -c '%s %Y %i' "$base0" 2>/dev/null)" "$(fp_files integrator orbis-graphics diag/stage0 diag/miniroot)" "target=$T" ;;
  esac
}
# fresh <step> <output>: true when the output exists and was built from the current inputs
fresh() {
  [ "$rebuild" = 0 ] && [ -e "$2" ] || return 1
  local want have; want="$(fp_of "$1")"; have="$(cat "out/.fp/$1" 2>/dev/null || true)"
  if [ "$want" = "$have" ]; then echo "   up to date: $2 (inputs unchanged; --rebuild to redo)"; return 0; fi
  [ -n "$have" ] && echo "   inputs changed since $2 was built: rebuilding" || echo "   no fingerprint for $2: rebuilding"
  return 1
}
mark() { fp_of "$1" > "out/.fp/$1"; }
# GE-A06: provenance next to every output, written right after the step
art_of() {   # step -> "artifact-name main-file"
  case "$1" in
    kernel) echo "kernel-ge out/kernel-ge/bzImage" ;;
    kernel-bore) echo "kernel-ge-bore out/kernel-ge-bore/bzImage" ;;
    kernel-uvd) echo "kernel-ge-uvd out/kernel-ge-uvd/bzImage" ;;
    kernel-sg) echo "kernel-ge-sg out/kernel-ge-sg/bzImage" ;;
    loader) echo "loader-ge out/loader-ge/build.json" ;;
    pack) echo "pack $PACK" ;;
    image@*) echo "image $IMG" ;;
    stage0@*) echo "stage0-image $IMG0" ;;
  esac
}
opts_json() { printf '{"bore": %s, "research_uvd": %s, "research_sgdisplay": %s, "jobs": "%s", "rust_kernel_toolchain": "%s", "kernel_flavor": "%s"}' \
  "$([ "$bore" = 1 ] && echo true || echo false)" "$([ "$uvd" = 1 ] && echo true || echo false)" \
  "$([ "$sgd" = 1 ] && echo true || echo false)" "${jobs:-auto}" "${RUST_KERNEL_TOOLCHAIN:-1.87.0}" "${FLAVOR:-aeolia-belize-6.15}"; }
prov() {     # prov <step> [target]
  local a m; read -r a m <<< "$(art_of "$1")"
  python3 build/provenance.py write "$a" "$(dirname "$m")" "$m" "$(cat "out/.fp/$1")" "${2:-flavor:${FLAVOR:-aeolia-belize-6.15}}" "$(opts_json)"
}
# GE-A05: the 0.2.0 checkout must be byte-for-byte the same after any step that reads it
guard_begin() { [ -z "$orbis_src" ] || python3 build/orbis_src_guard.py snapshot "$orbis_src" "out/.orbis-src-guard-$1.json" >/dev/null; }
guard_end() { [ -z "$orbis_src" ] || python3 build/orbis_src_guard.py verify "$orbis_src" "out/.orbis-src-guard-$1.json"; }
# run <step> <cmd...>: run with a log; the step's own exit code is kept
run() {
  local step="$1"; shift
  local log="out/logs/$step.log"
  echo "   log: $R/$log"
  { echo "### $(date -Is) $*"; } > "$log"
  set +e
  "$@" 2>&1 | tee -a "$log"
  local rc="${PIPESTATUS[0]}"
  set -e
  if [ "$rc" != 0 ]; then echo "!!! step '$step' failed (exit $rc); see $R/$log" >&2; exit "$rc"; fi
}

# ---------------------------------------------------------------- steps
step_check() {
  say "0 host checks (fast; no kernel/Mesa build)"
  run check-python python3 -m unittest discover -s tests/unit -q
  run check-targets targets_py target check
  if command -v cargo >/dev/null; then
    run check-rust bash -c "cd rust && cargo test --offline --locked -q"
  else
    echo "   cargo not installed on this machine: Rust tests run inside the pack build (makepkg check of orbis-native)"
  fi
}
kernel_variant() {   # kernel_variant <step-name> <outdir> [flag]
  if fresh "$1" "$2/build-manifest.json"; then return 0; fi
  guard_begin "$1"
  run "$1" kernel/build-ge-kernel.sh --orbis-src "$orbis_src" ${jobs:+--jobs "$jobs"} ${3:+"$3"}
  guard_end "$1"
  mark "$1"; prov "$1"
}
step_kernel() {
  say "1 kernel: Orbis 0.2.0 kernel + Graphics Engine series (flavor $FLAVOR)"
  need_src
  kernel_variant kernel out/kernel-ge
  if [ "$bore" = 1 ]; then say "1b BORE kernel (optional package linux-orbis-ps4-ge-bore)"; kernel_variant kernel-bore out/kernel-ge-bore --bore; fi
  if [ "$uvd" = 1 ]; then say "1c research UVD kernel (separate; never packed)"; kernel_variant kernel-uvd out/kernel-ge-uvd --research-uvd; fi
  if [ "$sgd" = 1 ]; then say "1d research GTT-scanout kernel (separate; never packed)"; kernel_variant kernel-sg out/kernel-ge-sg --research-sgdisplay; fi
}
step_loader() {
  say "2 loader payloads (ps4-linux-loader + GE memory-contract + time patch)"
  if fresh loader out/loader-ge/build.json; then return 0; fi
  run loader loader/build-loader.sh
  mark loader; prov loader
}
# explicit artifact selection for the pack (GE-A06): what was asked for, and only if current
select_artifacts() {
  local bw=not-requested; [ "$bore" = 1 ] && bw=requested
  local lw=optional; [ -e out/loader-ge/build.json ] && lw=requested
  python3 build/provenance.py select out/artifact-selection.json "flavor:$FLAVOR" "$(opts_json)" \
    "kernel-ge=out/kernel-ge:out/kernel-ge/bzImage:$(fp_of kernel):required" \
    "kernel-ge-bore=out/kernel-ge-bore:out/kernel-ge-bore/bzImage:$(fp_of kernel-bore):$bw" \
    "kernel-ge-uvd=out/kernel-ge-uvd:out/kernel-ge-uvd/bzImage:$(fp_of kernel-uvd):research-never-packed" \
    "kernel-ge-sg=out/kernel-ge-sg:out/kernel-ge-sg/bzImage:$(fp_of kernel-sg):research-never-packed" \
    "loader-ge=out/loader-ge:out/loader-ge/build.json:$(fp_of loader):$lw"
}
step_pack() {
  say "3 packages + pack (shared by every target of flavor $FLAVOR)"
  need_src
  select_artifacts || { echo "!!! the pack would contain stale or missing artifacts; rebuild them (see above)" >&2; exit 5; }
  if fresh pack "$PACK"; then return 0; fi
  local bf=(); [ "$bore" = 1 ] && bf=(--bore)
  run pack build/build-pack.sh --orbis-src "$orbis_src" --target "flavor:$FLAVOR" "${bf[@]}"
  mark pack; prov pack
}
step_image() {   # current target (use_target)
  say "4 bootable image for $T (copy of the base, GE integrated)"
  [ -n "$base" ] && [ -f "$base" ] || { echo "--base-image <Orbis 0.2.0 .img for $T> is required" >&2; exit 2; }
  mkdir -p "$TDIR/images"
  if fresh "image@$T" "$IMG"; then return 0; fi
  rm -f "$IMG" "$IMG".*   # never the base image: it is only read
  run "image-$T" ./orbis-graphics integrate --base-image "$base" --pack "$PACK" --output "$IMG"
  mark "image@$T"; prov "image@$T" "$T"
}
step_stage0() {
  say "5 stage-0 diagnostic image for $T"
  if [ -z "$base0" ]; then echo "   no --base-stage0-image for $T: skipped (optional)"; return 0; fi
  mkdir -p "$TDIR/images"
  if fresh "stage0@$T" "$IMG0"; then return 0; fi
  rm -f "$IMG0" "$IMG0".*
  run "stage0-$T" ./orbis-graphics stage0 --base-stage0-image "$base0" --pack "$PACK" --output "$IMG0"
  mark "stage0@$T"; prov "stage0@$T" "$T"
}
step_verify_pack() {
  say "6 verify pack"
  run verify-pack bash -c "./orbis-graphics verify --pack '$PACK' > out/pack-verify.json"
  ( cd out/release && sha256sum -c "$(basename "$PACK").sha256" )
}
step_verify() {   # current target
  say "6 verify + receipt for $T"
  # GE-A06: only images of this run's inputs, each checked against its provenance; an old
  # stage-0 image (or any other file) never slips into the checksums or the receipt
  local imgs=()
  if [ -n "$base" ] && python3 build/provenance.py check image "$TDIR/images" "$IMG" "$(fp_of "image@$T")"; then imgs+=("$IMG"); fi
  if [ -n "$base0" ] && python3 build/provenance.py check stage0-image "$TDIR/images" "$IMG0" "$(fp_of "stage0@$T")"; then imgs+=("$IMG0"); fi
  if [ -z "$base0" ] && [ -f "$IMG0" ]; then echo "   $IMG0 exists from an earlier run but no --base-stage0-image was given: left out"; fi
  local f
  for f in "${imgs[@]}"; do ./orbis-graphics inspect --image "$f" --json > "$f.inspect.json"; done
  mkdir -p "$TDIR/images"; rm -f "$TDIR/images/SHA256SUMS"
  if [ "${#imgs[@]}" -gt 0 ]; then ( cd "$TDIR/images" && for f in "${imgs[@]}"; do sha256sum -- "$(basename "$f")"; done > SHA256SUMS && cat SHA256SUMS ); fi
  local toolchain
  toolchain="$(printf '{"orbis-build:0.2.0": "%s", "orbis-gfx-build:%s": "%s", "engine": "%s", "host": "%s"}' \
    "$(image_id orbis-build:0.2.0)" "$ver" "$(image_id "orbis-gfx-build:$ver")" \
    "$(${ENGINE:-podman} --version 2>/dev/null || echo unknown)" "$(uname -srm)")"
  local sel_img="" sel_img0=""
  for f in "${imgs[@]}"; do [ "$f" = "$IMG" ] && sel_img="$IMG"; [ "$f" = "$IMG0" ] && sel_img0="$IMG0"; done
  python3 build/receipt.py "$PACK" "$sel_img" "$sel_img0" "${base:-}" "${base0:-}" "$toolchain" "${orbis_src:-}" "$T" "$TDIR" "$target_by"
}
step_runners() {
  say "runners: pinned GE-Proton / DXVK / VKD3D-Proton -> out/runners (verified: upstream SHA-512 + gaming/runners.lock.json)"
  mkdir -p out/runners out/native-host
  local fetch=(orbis-games fetch --dest out/runners --lock gaming/runners.lock.json ${only:+--only "$only"})
  if command -v cargo >/dev/null; then
    run runners-build bash -c "cd rust && CARGO_TARGET_DIR='$R/out/native-host' cargo build --release --offline --locked -p orbis-games"
    run runners env ORBIS_GAMES_CATALOG="$R/gaming/runners.json" "out/native-host/release/${fetch[0]}" "${fetch[@]:1}"
  else
    # no Rust on the Nobara: build and fetch inside the graphics build container (made by './orbis-ge pack')
    local engine; engine="$(command -v podman || command -v docker)" || { echo "need cargo or podman" >&2; exit 2; }
    run runners sudo "$engine" run --rm -v "$R":/src:z -w /src "orbis-gfx-build:$ver" bash -c \
      "cd rust && CARGO_TARGET_DIR=/src/out/native-host cargo build --release --offline --locked -p orbis-games && cd /src && \
       ORBIS_GAMES_CATALOG=/src/gaming/runners.json out/native-host/release/${fetch[*]}"
    sudo chown -R "$(id -u):$(id -g)" out/runners out/native-host gaming/runners.lock.json
  fi
  echo "   bundle: $R/out/runners (SHA256SUMS inside). New SHA-256 entries were added to gaming/runners.lock.json: review + commit."
  echo "   console: scp -r out/runners <user>@<ps4-ip>:~/runners && ssh <user>@<ps4-ip> orbis-games install --bundle ~/runners"
}
status_line() {
  local s="$1" f="$2" st=missing
  if [ -e "$f" ]; then
    st=present
    if [ -n "$orbis_src" ] || [ "$s" = loader ] || [[ "$s" == *@* ]]; then
      [ "$(fp_of "$s")" = "$(cat "out/.fp/$s" 2>/dev/null || true)" ] && st="present, current" || st="present, STALE (inputs changed)"
    fi
  fi
  printf '%-22s %-70s %s\n' "$s" "$f" "$st"
}
step_status() {
  local pair
  for pair in kernel:out/kernel-ge/build-manifest.json kernel-bore:out/kernel-ge-bore/build-manifest.json \
              kernel-uvd:out/kernel-ge-uvd/build-manifest.json kernel-sg:out/kernel-ge-sg/build-manifest.json \
              loader:out/loader-ge/build.json pack:"$PACK"; do
    status_line "${pair%%:*}" "${pair#*:}"
  done
  local t
  for t in "${TARGETS[@]}"; do
    use_target "$t"
    status_line "image@$t" "$IMG"; status_line "stage0@$t" "$IMG0"
  done
}

case "$cmd" in
  all|kernel|pack|image|stage0|verify|status) resolve_targets; check_base_args; resolve_flavor ;;
esac
case "$cmd" in
  all)
    command -v podman >/dev/null || { echo "need podman: sudo dnf install podman" >&2; exit 2; }
    need_src
    for t in "${TARGETS[@]}"; do use_target "$t"; [ -n "$base" ] && [ -f "$base" ] || {
      echo "--base-image <Orbis 0.2.0 .img> is required for $t (several targets: --base-image $t=<file>)" >&2; exit 2; }; done
    step_check; step_kernel; step_loader; step_pack; step_verify_pack
    for t in "${TARGETS[@]}"; do use_target "$t"; step_image; step_stage0; step_verify; done
    echo; echo "Done."
    for t in "${TARGETS[@]}"; do
      use_target "$t"; echo "  $t: $R/$IMG"
      if [ -f "$IMG0" ]; then echo "  $t stage-0: $R/$IMG0"; fi
      echo "  $t receipt: $R/$TDIR/ORBIS-GE-RELEASE-RECEIPT.json"
    done
    echo "  manifest: $R/out/RELEASE-MANIFEST.json" ;;
  check) step_check ;;
  kernel) step_kernel ;;
  loader) step_loader ;;
  pack) step_pack ;;
  image) for t in "${TARGETS[@]}"; do use_target "$t"; step_image; done ;;
  stage0) for t in "${TARGETS[@]}"; do use_target "$t"; step_stage0; done ;;
  verify) step_verify_pack; for t in "${TARGETS[@]}"; do use_target "$t"; step_verify; done ;;
  status) step_status ;;
  runners) step_runners ;;
  *) sed -n 2,37p "$0"; [ "$cmd" = help ] || exit 2 ;;
esac
