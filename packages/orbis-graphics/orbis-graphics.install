# NickLabs Orbis Graphics Pack: wire the per-personality GPU profiles into the Orbis targets.
post_install() {
  # with orbis-native installed, orbis-perf sets the per-mode GPU clock and fan instead
  if [ ! -x /usr/bin/orbis-perf ]; then
    for m in pc gaming ai; do
      systemctl add-wants "orbis-$m.target" "orbis-gpu-profile@$m.service" >/dev/null 2>&1 || true
    done
  fi
  systemctl enable orbis-gpu-boot-health.service >/dev/null 2>&1 || true
  mkdir -p /var/lib/orbis-graphics
  echo ":: orbis-graphics: run 'sudo orbis-gpu qualify' (or 'sudo orbis-qualify' after integration)"
}
post_upgrade() { post_install; }
pre_remove() {
  /usr/bin/orbis-gpu profile reset >/dev/null 2>&1 || true
  for m in pc gaming ai; do
    rm -f "/etc/systemd/system/orbis-$m.target.wants/orbis-gpu-profile@$m.service"
  done
  systemctl disable orbis-gpu-boot-health.service >/dev/null 2>&1 || true
}
